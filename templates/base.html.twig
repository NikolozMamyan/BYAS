<!DOCTYPE html>
{% set currentRoute = app.request.attributes.get('_route')|default('') %}
{% set isFrontApp = app.user and currentRoute starts with 'app_front_' %}
{% set swipePrevUrl = '' %}
{% set swipeNextUrl = '' %}
{% set swipePrevIcon = '' %}
{% set swipeNextIcon = '' %}
{% set swipePrevTitle = '' %}
{% set swipeNextTitle = '' %}
{% set swipePrevSubtitle = '' %}
{% set swipeNextSubtitle = '' %}
{% if currentRoute == 'app_front_passport' %}
  {% set swipeNextUrl = path('app_front_leaderboard') %}
  {% set swipeNextIcon = 'fa-chart-line' %}
  {% set swipeNextTitle = 'mobile_nav.leaderboard'|trans %}
  {% set swipeNextSubtitle = 'swipe.preview.leaderboard'|trans %}
{% elseif currentRoute starts with 'app_front_leaderboard' %}
  {% set swipePrevUrl = path('app_front_passport') %}
  {% set swipeNextUrl = path('app_front_play_history') %}
  {% set swipePrevIcon = 'fa-id-card' %}
  {% set swipeNextIcon = 'fa-clock-rotate-left' %}
  {% set swipePrevTitle = 'mobile_nav.passport'|trans %}
  {% set swipeNextTitle = 'mobile_nav.play_history'|trans %}
  {% set swipePrevSubtitle = 'swipe.preview.passport'|trans %}
  {% set swipeNextSubtitle = 'swipe.preview.play_history'|trans %}
{% elseif currentRoute starts with 'app_front_play_history' %}
  {% set swipePrevUrl = path('app_front_leaderboard') %}
  {% set swipePrevIcon = 'fa-chart-line' %}
  {% set swipePrevTitle = 'mobile_nav.leaderboard'|trans %}
  {% set swipePrevSubtitle = 'swipe.preview.leaderboard'|trans %}
{% endif %}
<html lang="{{ app.request.locale|default('en') }}">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0, viewport-fit=cover" />
    <meta name="theme-color" content="#060412" />
    <meta name="mobile-web-app-capable" content="yes" />
    <meta name="apple-mobile-web-app-capable" content="yes" />
    <meta name="apple-mobile-web-app-status-bar-style" content="black-translucent" />
    <meta name="apple-mobile-web-app-title" content="BYAS" />
    <link rel="manifest" href="{{ asset('manifest.webmanifest') }}" />
    <link rel="icon" type="image/png" sizes="192x192" href="{{ asset('icons/icon-192.png') }}" />
    <link rel="apple-touch-icon" href="{{ asset('icons/icon-192.png') }}" />
    <link
      rel="stylesheet"
      href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css"
      referrerpolicy="no-referrer"
    />

    <title>{% block title %}{{ 'common.welcome'|trans }}{% endblock %}</title>

    {# CSS global (idéalement via importmap/asset mapper). Laisse ton système actuel. #}
    {% block stylesheets %}
      <link rel="stylesheet" href="{{ asset('styles/global.css') }}">
    {% endblock %}

    {# Slot CSS page (évite de mettre des <style> dans le body) #}
    {% block page_styles %}{% endblock %}

    {% block javascripts %}
      {% block importmap %}{{ importmap('app') }}{% endblock %}
    {% endblock %}
      </head>
      <body data-turbo="false" data-route="{{ currentRoute }}">
        {% if isFrontApp and (swipePrevUrl or swipeNextUrl) %}
        <div class="swipe-preview-layer" aria-hidden="true">
          {% if swipePrevUrl %}
          <div class="swipe-preview swipe-preview--left">
            <div class="swipe-preview__chip">{{ 'swipe.preview.previous'|trans }}</div>
            <div class="swipe-preview__icon"><i class="fas {{ swipePrevIcon }}"></i></div>
            <div class="swipe-preview__title">{{ swipePrevTitle }}</div>
            <div class="swipe-preview__text">{{ swipePrevSubtitle }}</div>
          </div>
          {% endif %}
          {% if swipeNextUrl %}
          <div class="swipe-preview swipe-preview--right">
            <div class="swipe-preview__chip">{{ 'swipe.preview.next'|trans }}</div>
            <div class="swipe-preview__icon"><i class="fas {{ swipeNextIcon }}"></i></div>
            <div class="swipe-preview__title">{{ swipeNextTitle }}</div>
            <div class="swipe-preview__text">{{ swipeNextSubtitle }}</div>
          </div>
          {% endif %}
        </div>
        {% endif %}
        <div
          class="app-shell"
          id="appShell"
          data-app-route="{{ currentRoute }}"
          data-swipe-prev-url="{{ swipePrevUrl }}"
          data-swipe-next-url="{{ swipeNextUrl }}"
        >
          {% if isFrontApp %}
          {% include "components/app_header.html.twig" %}
          {% endif %}
          {% block body %}{% endblock %}
          {% if isFrontApp %}
          {% include "components/mobile_nav.html.twig" %}
          {% endif %}
        </div>
    </body>
</html>
