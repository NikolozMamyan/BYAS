{% extends 'base.html.twig' %}

{% block title %}BYAS | {{ 'auth.login.submit'|trans }}{% endblock %}

{% block stylesheets %}
  {{ parent() }}
  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  <link href="https://fonts.googleapis.com/css2?family=Exo+2:wght@400;600;700;800&family=Rajdhani:wght@500;600;700&display=swap" rel="stylesheet">
{% endblock %}

{% block page_styles %}
  <link rel="stylesheet" href="{{ asset('styles/auth/login.css') }}">
{% endblock %}

{% block body %}
<div class="login-page">
  <div class="login-bg"></div>
  <div class="login-bg-overlay"></div>
  <div class="login-planet"></div>

  <main class="login-shell">
    <a class="login-back" href="{{ path('app_landing') }}" aria-label="{{ 'common.back_to_home'|trans }}">
      <i class="fa-solid fa-arrow-left"></i>
    </a>

    <section class="login-brand">
      <img src="{{ asset('img/logo/BYAS LOGO.png') }}" alt="BYAS">
    </section>

    <section class="login-card">
      <div class="login-card-border"></div>

      <div class="login-card-inner">
        <div class="login-divider" aria-hidden="true">
          <span class="login-divider-line"></span>
          <span class="login-divider-star">*</span>
          <span class="login-divider-line"></span>
        </div>

        <header class="login-copy">
          <h1>{{ 'auth.login.hero_title'|trans }}</h1>
          <p>{{ 'auth.login.hero_subtitle'|trans }}</p>
        </header>

        {% include 'components/language_switcher.html.twig' with { id: 'loginLocaleSwitcher' } only %}

        {% for message in app.flashes('error') %}
          <div class="login-feedback login-feedback-error">
            <i class="fa-solid fa-circle-exclamation" aria-hidden="true"></i>
            <span>{{ message }}</span>
          </div>
        {% endfor %}

        {% for message in app.flashes('success') %}
          <div class="login-feedback login-feedback-success">
            <i class="fa-solid fa-circle-check" aria-hidden="true"></i>
            <span>{{ message }}</span>
          </div>
        {% endfor %}

        <form
          id="loginForm"
          class="login-form"
          data-controller="login"
          data-action="submit->login#submit"
          data-next="{{ next|default('') }}"
        >
          <div class="login-feedback login-feedback-error" data-login-target="error" hidden></div>

          <label class="login-field">
            <span class="login-field-icon"><i class="fa-regular fa-envelope" aria-hidden="true"></i></span>
            <input
              type="email"
              id="username"
              name="_username"
              value=""
              placeholder="{{ 'auth.login.email'|trans }}"
              data-login-target="email"
              required
            >
          </label>

          <label class="login-field">
            <span class="login-field-icon"><i class="fa-solid fa-lock" aria-hidden="true"></i></span>
            <input
              type="password"
              id="password"
              name="_password"
              placeholder="{{ 'auth.login.password'|trans }}"
              data-login-target="password"
              required
            >
          </label>

          <button type="submit" class="login-submit" data-login-target="submit">
            {{ 'auth.login.submit'|trans }}
            <i class="fa-solid fa-arrow-right" aria-hidden="true"></i>
          </button>
        </form>

        <div class="login-or">
          <span class="login-or-line"></span>
          <span class="login-or-text">{{ 'common.or'|trans }}</span>
          <span class="login-or-line"></span>
        </div>

        <p class="login-register-link">
          {{ 'auth.login.no_account'|trans }}
          <a href="{{ path('show_register', { intent: intent|default(null), passport: passport|default(null), next: next|default(null) }) }}" data-turbo="false">
            {{ 'auth.register.title_short'|trans }}
          </a>
        </p>

        <div class="login-legal">
          <div class="login-legal-icon">
            <i class="fa-solid fa-lock" aria-hidden="true"></i>
          </div>
          <p>
            {{ 'auth.legal.prefix'|trans }}
            <a href="#">{{ 'auth.legal.terms'|trans }}</a>
            {{ 'auth.legal.and'|trans }}
            <a href="#">{{ 'auth.legal.privacy'|trans }}</a>.
          </p>
        </div>
      </div>
    </section>
  </main>
</div>
{% endblock %}
