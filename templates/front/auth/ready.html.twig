{% extends 'base.html.twig' %}

{% block title %}BYAS | {{ 'ready.title'|trans }}{% endblock %}

{% block stylesheets %}
  {{ parent() }}
  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  <link href="https://fonts.googleapis.com/css2?family=Exo+2:wght@400;600;700;800&family=Rajdhani:wght@500;600;700&display=swap" rel="stylesheet">
{% endblock %}

{% block page_styles %}
  <link rel="stylesheet" href="{{ asset('styles/auth/ready.css') }}">
{% endblock %}

{% block body %}
<div class="ready-page">
  <div class="ready-bg"></div>
  <div class="ready-bg-overlay"></div>

  <main class="ready-shell">
    <section class="ready-brand">
      <img src="{{ asset('img/logo/BYAS LOGO.png') }}" alt="BYAS">
    </section>

    <a class="ready-share" href="{{ continueUrl }}" aria-label="{{ 'ready.continue_aria'|trans }}">
      <i class="fa-solid fa-arrow-up-from-bracket"></i>
    </a>

    <header class="ready-copy">
      <h1>{{ 'ready.heading_prefix'|trans }} <span>{{ 'ready.heading_suffix'|trans }}</span></h1>
      <p>{{ 'ready.subtitle'|trans }}</p>
    </header>

    <section class="ready-passport-wrap" aria-hidden="true">
      <div class="ready-orbit"></div>
      <img src="{{ asset('img/landing/Main_asset 1.png') }}" alt="" class="ready-passport">
    </section>

    <section class="ready-fandom">
      <div class="ready-fandom-line">
        <span class="ready-fandom-star">✦</span>
        <p>{{ 'ready.you_are_now'|trans }}</p>
        <span class="ready-fandom-star">✦</span>
      </div>
      <div class="ready-fandom-name">♥ {{ selectedFandom }} ♥</div>
      <div class="ready-fandom-artist">{{ selectedArtist }}</div>
    </section>

    <a class="ready-submit" href="{{ continueUrl }}">
      <span>{{ 'ready.enter'|trans }}</span>
      <i class="fa-solid fa-arrow-right" aria-hidden="true"></i>
    </a>

    <div class="ready-footnote">
      <i class="fa-solid fa-bolt"></i>
      <span>{{ 'ready.start_xp'|trans }}</span>
    </div>
  </main>
</div>
{% endblock %}
