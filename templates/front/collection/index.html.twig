{% extends 'base.html.twig' %}

{% block title %}BYAS | {{ 'collection.title'|trans }}{% endblock %}

{% block stylesheets %}
{{ parent() }}
<link rel="stylesheet" href="{{ asset('styles/front/collection.css') }}">
{% endblock %}

{% block body %}
<div class="collection-page">
    <header class="collection-header">
        <h1>{{ 'collection.showcase'|trans }}</h1>
        <p class="collection-summary">
            {{ 'collection.summary'|trans({ '%count%': items|length, '%name%': user.displayName }) }}
        </p>
    </header>

    {% if shelves is empty %}
        <div class="collection-empty">
            <i class="fas fa-box-open collection-empty__icon"></i>
            <p>{{ 'collection.empty'|trans }}</p>
        </div>
    {% else %}
        {% for shelfName, shelfItems in shelves %}
            <section class="shelf-block">
                <h2 class="shelf-title">
                    <i class="fas fa-compact-disc"></i> {{ shelfName }}
                </h2>

                <div class="shelf-grid">
                    {% for item in shelfItems %}
                        <article class="collection-card">
                            <div class="qty-badge">x{{ item.quantity }}</div>
                            
                            <div class="album-cover-placeholder">
                 
                                    <i class="fas fa-record-vinyl"></i>
                            </div>

                            <div class="album-info">
                                <div class="collection-type">{{ item.type ? item.type.label : 'collection.item_fallback'|trans }}</div>
                                <div class="collection-title">{{ item.title }}</div>
                                <div class="collection-artist">{{ item.artist ? item.artist.name : 'collection.various'|trans }}</div>
                            </div>
                        </article>
                    {% endfor %}
                </div>
            </section>
        {% endfor %}
    {% endif %}


</div>
{% endblock %}
