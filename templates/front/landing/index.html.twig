{% extends 'base.html.twig' %}

{% block title %}BYAS - {{ 'landing.title'|trans }}{% endblock %}

{% block stylesheets %}
    {{ parent() }}
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Exo+2:wght@300;400;600;700;800;900&family=Rajdhani:wght@400;500;600;700&display=swap" rel="stylesheet">
{% endblock %}

{% block page_styles %}
    <link rel="stylesheet" href="{{ asset('styles/landing/index.css') }}">
{% endblock %}

{% block body %}
    <div
        class="pwa-install"
        data-controller="pwa-install"
        data-pwa-install-installed-message-value="{{ 'pwa.status.installed'|trans }}"
        data-pwa-install-unavailable-message-value="{{ 'pwa.status.unavailable'|trans }}"
        data-pwa-install-started-message-value="{{ 'pwa.status.started'|trans }}"
        data-pwa-install-later-message-value="{{ 'pwa.status.later'|trans }}"
    >
        <div class="pwa-install__backdrop" data-pwa-install-target="dialog" hidden>
            <div class="pwa-install__modal" role="dialog" aria-modal="true" aria-labelledby="pwaInstallTitle">
                <div class="pwa-install__eyebrow">{{ 'pwa.install.eyebrow'|trans }}</div>
                <h3 class="pwa-install__title" id="pwaInstallTitle">{{ 'pwa.install.title'|trans }}</h3>
                <p class="pwa-install__text">
                    {{ 'pwa.install.text'|trans }}
                </p>
                <div class="pwa-install__chips">
                    <span>{{ 'pwa.install.chip_home'|trans }}</span>
                    <span>{{ 'pwa.install.chip_fullscreen'|trans }}</span>
                    <span>{{ 'pwa.install.chip_reopen'|trans }}</span>
                </div>
                <div class="pwa-install__actions">
                    <button type="button" class="pwa-install__button pwa-install__button--primary" data-pwa-install-target="installButton" data-action="pwa-install#install">
                        {{ 'pwa.install.install'|trans }}
                    </button>
                    <button type="button" class="pwa-install__button pwa-install__button--ghost" data-action="pwa-install#later">
                        {{ 'pwa.install.later'|trans }}
                    </button>
                </div>
                <div class="pwa-install__status" data-pwa-install-target="status" aria-live="polite"></div>
            </div>
        </div>
    </div>

    <div class="bg-main"></div>
    <div class="bg-overlay"></div>

    <div class="sidebar">
        <span class="sidebar-text">BYAS</span>
        <div class="sidebar-line"></div>
        <div class="sidebar-dot"></div>
        <div class="sidebar-line"></div>
        <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="#4a48eb" stroke-width="1.5" class="sidebar-globe">
            <circle cx="12" cy="12" r="10"></circle>
            <path d="M12 2a14.5 14.5 0 0 0 0 20M12 2a14.5 14.5 0 0 1 0 20M2 12h20"></path>
        </svg>
    </div>

    <div class="page">
        <div class="logo-wrap">
            <img src="{{ asset('img/logo/BYAS LOGO.png') }}" class="logo-img" alt="BYAS">
        </div>

        <svg class="divider-asset-img" viewBox="0 0 220 40" xmlns="http://www.w3.org/2000/svg" aria-hidden="true">
            <defs>
                <linearGradient id="dividerLine" x1="0%" y1="0%" x2="100%" y2="0%">
                    <stop offset="0%" stop-color="transparent"/>
                    <stop offset="35%" stop-color="#4a48eb"/>
                    <stop offset="65%" stop-color="#f83cb0"/>
                    <stop offset="100%" stop-color="transparent"/>
                </linearGradient>
                <linearGradient id="dividerStar" x1="0%" y1="0%" x2="100%" y2="100%">
                    <stop offset="0%" stop-color="#4a48eb"/>
                    <stop offset="100%" stop-color="#f83cb0"/>
                </linearGradient>
            </defs>
            <line x1="0" y1="20" x2="78" y2="20" stroke="url(#dividerLine)" stroke-width="1.2"/>
            <line x1="142" y1="20" x2="220" y2="20" stroke="url(#dividerLine)" stroke-width="1.2"/>
            <polygon points="110,8 114,16 122,20 114,24 110,32 106,24 98,20 106,16" fill="url(#dividerStar)"/>
        </svg>

        <div class="tagline">
            <h2>{{ 'landing.hero.line1'|trans }}<br>{{ 'landing.hero.line2'|trans }} <span>{{ 'landing.hero.line2_highlight'|trans }}</span></h2>
        </div>

        <div class="passport-wrap" id="passportWrap">
            <div class="passport" id="passport">
                <img src="{{ asset('img/landing/Main_asset 1.png') }}" class="passport-asset-img" alt="">

                <div class="passport-inner">
                    <div class="p-header">
                        <span class="p-brand">BYAS</span>
                        <span class="p-passport-label">
                            {{ 'landing.passport.label'|trans }}
                            <svg width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5">
                                <circle cx="12" cy="12" r="10"></circle>
                                <path d="M12 2a14.5 14.5 0 0 0 0 20M12 2a14.5 14.5 0 0 1 0 20M2 12h20"></path>
                            </svg>
                        </span>
                    </div>
                    <div class="p-divider"></div>

                    <div class="p-profile">
                        <svg class="world-map" viewBox="0 0 200 130" xmlns="http://www.w3.org/2000/svg">
                            <g fill="rgba(248,60,176,1)">
                                <circle cx="15" cy="25" r="1.8"/><circle cx="24" cy="20" r="1.8"/><circle cx="33" cy="24" r="1.8"/>
                                <circle cx="42" cy="18" r="1.8"/><circle cx="51" cy="23" r="1.8"/><circle cx="60" cy="27" r="1.8"/>
                                <circle cx="69" cy="20" r="1.8"/><circle cx="78" cy="25" r="1.8"/><circle cx="87" cy="22" r="1.8"/>
                                <circle cx="96" cy="17" r="1.8"/><circle cx="105" cy="24" r="1.8"/><circle cx="114" cy="19" r="1.8"/>
                                <circle cx="123" cy="26" r="1.8"/><circle cx="132" cy="21" r="1.8"/><circle cx="141" cy="17" r="1.8"/>
                                <circle cx="150" cy="23" r="1.8"/><circle cx="159" cy="27" r="1.8"/><circle cx="168" cy="20" r="1.8"/>
                                <circle cx="177" cy="25" r="1.8"/><circle cx="186" cy="18" r="1.8"/>
                                <circle cx="10" cy="38" r="1.8"/><circle cx="22" cy="35" r="1.8"/><circle cx="34" cy="40" r="1.8"/>
                                <circle cx="46" cy="34" r="1.8"/><circle cx="58" cy="38" r="1.8"/><circle cx="70" cy="36" r="1.8"/>
                                <circle cx="82" cy="40" r="1.8"/><circle cx="94" cy="35" r="1.8"/><circle cx="106" cy="39" r="1.8"/>
                                <circle cx="118" cy="34" r="1.8"/><circle cx="130" cy="40" r="1.8"/><circle cx="142" cy="36" r="1.8"/>
                                <circle cx="154" cy="38" r="1.8"/><circle cx="166" cy="33" r="1.8"/><circle cx="178" cy="39" r="1.8"/>
                                <circle cx="190" cy="35" r="1.8"/>
                            </g>
                        </svg>

                        <div class="p-avatar-wrap">
                            <svg class="p-avatar-ring-svg" viewBox="0 0 100 100">
                                <defs>
                                    <linearGradient id="ringGrad" x1="0%" y1="0%" x2="100%" y2="100%">
                                        <stop offset="0%" stop-color="#f83cb0" stop-opacity="1"/>
                                        <stop offset="50%" stop-color="#6316d0" stop-opacity="0.3"/>
                                        <stop offset="100%" stop-color="#f83cb0" stop-opacity="1"/>
                                    </linearGradient>
                                </defs>
                                <circle cx="50" cy="50" r="46" fill="none" stroke="url(#ringGrad)" stroke-width="2.5" stroke-dasharray="200 89"/>
                            </svg>
                            <div class="p-avatar">
                                <svg width="92" height="92" viewBox="0 0 92 92">
                                    <defs>
                                        <radialGradient id="avBg" cx="50%" cy="30%" r="70%">
                                            <stop offset="0%" stop-color="#3a1060"/>
                                            <stop offset="100%" stop-color="#0d0425"/>
                                        </radialGradient>
                                    </defs>
                                    <circle cx="46" cy="46" r="46" fill="url(#avBg)"/>
                                    <circle cx="46" cy="34" r="14" fill="rgba(240,200,220,0.65)"/>
                                    <ellipse cx="46" cy="75" rx="22" ry="18" fill="rgba(240,200,220,0.4)"/>
                                </svg>
                            </div>
                            <div class="p-level">
                                <span class="p-level-label">{{ 'landing.passport.level_short'|trans }}</span>
                                <span class="p-level-num">23</span>
                            </div>
                        </div>

                        <div class="p-info">
                            <div class="p-fanname">BLINK <span class="p-heart">&hearts;</span></div>
                            <div class="p-since">{{ 'landing.passport.since'|trans }}</div>
                            <div class="p-badge">
                                <svg width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="#f83cb0" stroke-width="2">
                                    <polygon points="12,2 15.09,8.26 22,9.27 17,14.14 18.18,21.02 12,17.77 5.82,21.02 7,14.14 2,9.27 8.91,8.26"></polygon>
                                </svg>
                                {{ 'landing.passport.badge'|trans }}
                            </div>
                            <div class="p-xp-row">
                                <span class="p-xp-lvl">23</span>
                                <div class="p-xp-bar"><div class="p-xp-fill"></div></div>
                                <span class="p-xp-lvl">24</span>
                            </div>
                            <div class="p-xp-amount">4,250 / 5,000 XP</div>
                        </div>
                    </div>

                    <div class="p-stats">
                        <div class="p-stat">
                            <div class="p-stat-icon">
                                <svg viewBox="0 0 24 24"><path d="M3 18v-6a9 9 0 0 1 18 0v6"/><path d="M21 19a2 2 0 0 1-2 2h-1a2 2 0 0 1-2-2v-3a2 2 0 0 1 2-2h3z"/><path d="M3 19a2 2 0 0 0 2 2h1a2 2 0 0 0 2-2v-3a2 2 0 0 0-2-2H3z"/></svg>
                            </div>
                            <div class="p-stat-label">{{ 'landing.passport.streams'|trans }}</div>
                            <div class="p-stat-val" data-target="12600">12.6K</div>
                        </div>
                        <div class="p-stat">
                            <div class="p-stat-icon"><svg viewBox="0 0 24 24"><polygon points="5,3 19,12 5,21"/></svg></div>
                            <div class="p-stat-label">{{ 'landing.passport.views'|trans }}</div>
                            <div class="p-stat-val" data-target="8700">8.7K</div>
                        </div>
                        <div class="p-stat">
                            <div class="p-stat-icon"><svg viewBox="0 0 24 24"><path d="M2 3h6a4 4 0 0 1 4 4v14a3 3 0 0 0-3-3H2z"/><path d="M22 3h-6a4 4 0 0 0-4 4v14a3 3 0 0 1 3-3h7z"/></svg></div>
                            <div class="p-stat-label">{{ 'landing.passport.articles'|trans }}</div>
                            <div class="p-stat-val" data-target="156">156</div>
                        </div>
                        <div class="p-stat">
                            <div class="p-stat-icon"><svg viewBox="0 0 24 24"><rect x="3" y="4" width="18" height="18" rx="2"/><line x1="16" y1="2" x2="16" y2="6"/><line x1="8" y1="2" x2="8" y2="6"/><path d="M12 9l1.5 3h3l-2.5 2 1 3-3-2-3 2 1-3-2.5-2H10.5z"/></svg></div>
                            <div class="p-stat-label">{{ 'landing.passport.events'|trans }}</div>
                            <div class="p-stat-val" data-target="3">3</div>
                        </div>
                        <div class="p-stat">
                            <div class="p-stat-icon"><svg viewBox="0 0 24 24"><path d="M6.5 6.5l2-4.5 1.5 3.5 4-1.5-1.5 4 3.5 2-3.5 1 1.5 4-4-2-1.5 3.5-2-4L3 15l2-3.5L1 10l4.5-1z"/><circle cx="17.5" cy="15.5" r="4.5"/><path d="M17.5 13v2.5l1.5 1"/></svg></div>
                            <div class="p-stat-label">{{ 'landing.passport.badges'|trans }}</div>
                            <div class="p-stat-val" data-target="42">42</div>
                        </div>
                    </div>

                    <div class="p-footer">
                        <div class="p-footer-main">
                            <div class="p-barcode" id="barcode"></div>
                            <div class="p-official-text">{{ 'landing.passport.official'|trans }}</div>
                        </div>
                        <div class="p-seal">
                            <svg width="0" height="0">
                                <defs>
                                    <linearGradient id="sealGrad" x1="0%" y1="0%" x2="100%" y2="100%">
                                        <stop offset="0%" stop-color="#4a48eb"/>
                                        <stop offset="100%" stop-color="#f83cb0"/>
                                    </linearGradient>
                                </defs>
                            </svg>
                            <div class="p-seal-inner">
                                <span class="p-seal-top">★ BYAS ★</span>
                                <svg class="p-seal-globe-icon" viewBox="0 0 24 24">
                                    <circle cx="12" cy="12" r="10" stroke="url(#sealGrad)" stroke-width="1.2" fill="none"/>
                                    <ellipse cx="12" cy="12" rx="4" ry="10" stroke="url(#sealGrad)" stroke-width="1.2" fill="none"/>
                                    <line x1="2" y1="12" x2="22" y2="12" stroke="url(#sealGrad)" stroke-width="1.2"/>
                                    <line x1="12" y1="2" x2="12" y2="22" stroke="url(#sealGrad)" stroke-width="1.2"/>
                                </svg>
                                <span class="p-seal-bottom">{{ 'landing.passport.official_short'|trans }}</span>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </div>

        <div class="cta-section">
            <a class="btn-primary" href="{{ path('show_register') }}">
                <span>{{ 'landing.cta.register'|trans }}</span>
                <span class="btn-icon"><i class="fa-solid fa-arrow-right"></i></span>
            </a>

            <div class="divider-or">
                <div class="divider-or-line"></div>
                <span class="divider-or-text">{{ 'common.or'|trans }}</span>
                <div class="divider-or-line"></div>
            </div>

            <a class="btn-secondary" href="{{ path('show_login') }}">
                <span>{{ 'auth.login.submit'|trans }}</span>
                <span class="btn-icon"><i class="fa-solid fa-arrow-right"></i></span>
            </a>

            <p class="legal">
                {{ 'landing.legal.prefix'|trans }}<br>
                <a href="#">{{ 'landing.legal.terms'|trans }}</a> {{ 'auth.legal.and'|trans }} <a href="#">{{ 'auth.legal.privacy'|trans }}</a>.
            </p>
        </div>
    </div>

    <script>
        const barcodeEl = document.getElementById('barcode');
        const bars = [3,1,2,1,3,2,1,1,2,3,1,2,1,3,1,1,2,1,3,2,1,1,2,3,1,2,1,3,2,1,1,2,1,3,1,2,3,1,1,2,1,3,1,2,2,1];
        bars.forEach((w, i) => {
            const bar = document.createElement('div');
            bar.className = 'p-barcode-bar';
            bar.style.cssText = 'width:' + w + 'px;height:' + (i % 5 === 0 ? 32 : i % 3 === 0 ? 24 : 28) + 'px;';
            barcodeEl.appendChild(bar);
        });

        const wrap = document.getElementById('passportWrap');
        const card = document.getElementById('passport');
        wrap.addEventListener('mousemove', e => {
            const r = wrap.getBoundingClientRect();
            const x = (e.clientX - r.left) / r.width - 0.5;
            const y = (e.clientY - r.top) / r.height - 0.5;
            card.style.transform = 'perspective(900px) rotateY(' + (x * 9) + 'deg) rotateX(' + (-y * 7) + 'deg) scale(1.015)';
            card.style.transition = 'none';
        });
        wrap.addEventListener('mouseleave', () => {
            card.style.transform = '';
            card.style.transition = 'transform 0.6s cubic-bezier(.22,1,.36,1)';
        });
        wrap.addEventListener('touchmove', e => {
            const t = e.touches[0];
            const r = wrap.getBoundingClientRect();
            const x = (t.clientX - r.left) / r.width - 0.5;
            const y = (t.clientY - r.top) / r.height - 0.5;
            card.style.transform = 'perspective(900px) rotateY(' + (x * 7) + 'deg) rotateX(' + (-y * 5) + 'deg) scale(1.01)';
            card.style.transition = 'none';
        }, { passive: true });
        wrap.addEventListener('touchend', () => {
            card.style.transform = '';
            card.style.transition = 'transform 0.6s cubic-bezier(.22,1,.36,1)';
        });

        function animateCounter(el, target) {
            let cur = 0;
            const dur = 1400;
            const step = target / (dur / 16);
            const t = setInterval(() => {
                cur = Math.min(cur + step, target);
                if (target >= 1000) {
                    el.textContent = (cur / 1000).toFixed(1) + 'K';
                } else {
                    el.textContent = Math.floor(cur);
                }
                if (cur >= target) {
                    clearInterval(t);
                }
            }, 16);
        }

        const obs = new IntersectionObserver(entries => {
            if (entries[0].isIntersecting) {
                document.querySelectorAll('.p-stat-val').forEach(el => {
                    animateCounter(el, +el.dataset.target);
                });
                obs.disconnect();
            }
        }, { threshold: 0.4 });
        obs.observe(document.querySelector('.passport'));
    </script>
{% endblock %}
