{% extends 'base.html.twig' %}

{% block title %}BYAS | {{ 'leaderboard.title'|trans }}{% endblock %}

{% block stylesheets %}
{{ parent() }}
<link rel="stylesheet" href="{{ asset('styles/front/leaderboard.css') }}">
{% endblock %}

{% block body %}
<div class="leaderboard-page native-screen is-hydrating" data-controller="screen-shell">
    <div class="screen-skeleton leaderboard-screen-skeleton" aria-hidden="true">
        <div class="screen-skeleton__panel"></div>
        <div class="screen-skeleton__grid screen-skeleton__grid--three">
            <div class="screen-skeleton__card"></div>
            <div class="screen-skeleton__card"></div>
            <div class="screen-skeleton__card"></div>
        </div>
        <div class="screen-skeleton__stack">
            <div class="screen-skeleton__row"></div>
            <div class="screen-skeleton__row"></div>
            <div class="screen-skeleton__row"></div>
        </div>
    </div>
    <div class="screen-content">
    {% set first = podium[0] ?? null %}
    {% set second = podium[1] ?? null %}
    {% set third = podium[2] ?? null %}

    <section class="ranking-hero">
        <div class="ranking-hero-inner">
            <div class="ranking-kicker">
                <i class="fas fa-trophy"></i>
                {{ 'leaderboard.kicker'|trans }}
            </div>

            <h1 class="ranking-title">{{ 'leaderboard.heading'|trans }}</h1>

            <p class="ranking-subtitle">
                {{ 'leaderboard.subtitle'|trans }}
            </p>

            <div class="ranking-stats">
                <div class="ranking-stat">
                    <div class="ranking-stat-label">{{ 'leaderboard.mode'|trans }}</div>
                    <div class="ranking-stat-value">{{ mode }}</div>
                </div>
                <div class="ranking-stat">
                    <div class="ranking-stat-label">{{ 'leaderboard.players'|trans }}</div>
                    <div class="ranking-stat-value">{{ playerCount }}</div>
                </div>
                <div class="ranking-stat">
                    <div class="ranking-stat-label">{{ 'leaderboard.your_rank'|trans }}</div>
                    <div class="ranking-stat-value">{{ currentUserRank ? '#' ~ currentUserRank : '-' }}</div>
                </div>
            </div>
        </div>
    </section>

    <div class="fandom-tabs">
        <a href="{{ path('app_front_leaderboard') }}" class="fandom-tab {{ selectedArtist ? '' : 'active' }}">{{ 'leaderboard.global'|trans }}</a>
        {% for artist in artists %}
            <a href="{{ path('app_front_leaderboard', { artist: artist.slug }) }}" class="fandom-tab {{ selectedArtist and selectedArtist.id == artist.id ? 'active' : '' }}">{{ artist.name }}</a>
        {% endfor %}
    </div>

    <section class="podium-shell">
        <div class="podium-title">
            <i class="fas fa-crown"></i>
            {{ 'leaderboard.top3'|trans }}
        </div>

        <div class="podium-section">
            <article class="podium-card second">
                <div class="podium-rank-chip">#2</div>
                {% if second and second.profileUrl %}
                    <a href="{{ second.profileUrl }}" class="profile-link">
                        <div class="podium-avatar-wrapper">
                            {% include 'components/user_avatar.html.twig' with { avatarUrl: second.avatarUrl, displayName: second.displayName, avatarClass: 'podium-avatar' } only %}
                        </div>
                        <p class="podium-name">{{ second.displayName }}</p>
                        <span class="podium-xp">{{ second.xp }} XP</span>
                        <span class="podium-label">{{ 'leaderboard.silver_tier'|trans }}</span>
                    </a>
                {% else %}
                    <div class="podium-avatar-wrapper">
                        {% include 'components/user_avatar.html.twig' with { avatarUrl: second ? second.avatarUrl : null, displayName: second ? second.displayName : ('leaderboard.open_spot'|trans), avatarClass: 'podium-avatar' } only %}
                    </div>
                    <p class="podium-name">{{ second ? second.displayName : ('leaderboard.open_spot'|trans) }}</p>
                    <span class="podium-xp">{{ second ? second.xp : 0 }} XP</span>
                    <span class="podium-label">{{ 'leaderboard.silver_tier'|trans }}</span>
                {% endif %}
            </article>

            <article class="podium-card first">
                <div class="podium-rank-chip">#1</div>
                <i class="fas fa-crown crown"></i>
                {% if first and first.profileUrl %}
                    <a href="{{ first.profileUrl }}" class="profile-link">
                        <div class="podium-avatar-wrapper">
                            {% include 'components/user_avatar.html.twig' with { avatarUrl: first.avatarUrl, displayName: first.displayName, avatarClass: 'podium-avatar' } only %}
                        </div>
                        <p class="podium-name">{{ first.displayName }}</p>
                        <span class="podium-xp">{{ first.xp }} XP</span>
                        <span class="podium-label">{{ 'leaderboard.legend'|trans }}</span>
                    </a>
                {% else %}
                    <div class="podium-avatar-wrapper">
                        {% include 'components/user_avatar.html.twig' with { avatarUrl: first ? first.avatarUrl : null, displayName: first ? first.displayName : ('leaderboard.open_spot'|trans), avatarClass: 'podium-avatar' } only %}
                    </div>
                    <p class="podium-name">{{ first ? first.displayName : ('leaderboard.open_spot'|trans) }}</p>
                    <span class="podium-xp">{{ first ? first.xp : 0 }} XP</span>
                    <span class="podium-label">{{ 'leaderboard.legend'|trans }}</span>
                {% endif %}
            </article>

            <article class="podium-card third">
                <div class="podium-rank-chip">#3</div>
                {% if third and third.profileUrl %}
                    <a href="{{ third.profileUrl }}" class="profile-link">
                        <div class="podium-avatar-wrapper">
                            {% include 'components/user_avatar.html.twig' with { avatarUrl: third.avatarUrl, displayName: third.displayName, avatarClass: 'podium-avatar' } only %}
                        </div>
                        <p class="podium-name">{{ third.displayName }}</p>
                        <span class="podium-xp">{{ third.xp }} XP</span>
                        <span class="podium-label">{{ 'leaderboard.bronze_tier'|trans }}</span>
                    </a>
                {% else %}
                    <div class="podium-avatar-wrapper">
                        {% include 'components/user_avatar.html.twig' with { avatarUrl: third ? third.avatarUrl : null, displayName: third ? third.displayName : ('leaderboard.open_spot'|trans), avatarClass: 'podium-avatar' } only %}
                    </div>
                    <p class="podium-name">{{ third ? third.displayName : ('leaderboard.open_spot'|trans) }}</p>
                    <span class="podium-xp">{{ third ? third.xp : 0 }} XP</span>
                    <span class="podium-label">{{ 'leaderboard.bronze_tier'|trans }}</span>
                {% endif %}
            </article>
        </div>
    </section>

    <section class="rank-list-shell">
        <div class="list-head">
            <h2>{{ 'leaderboard.list_title'|trans }}</h2>
            <span>{{ 'leaderboard.positions_4_plus'|trans }}</span>
        </div>

        <div class="rank-list">
            {% for user in others %}
                {% set position = loop.index + 3 %}
                <div class="rank-item {{ currentUser and currentUser.id == user.userId ? 'is-me' : '' }}">
                    <div class="rank-pos">{{ position }}</div>

                    {% if user.profileUrl %}
                        <a href="{{ user.profileUrl }}" class="rank-info profile-link">
                            {% include 'components/user_avatar.html.twig' with { avatarUrl: user.avatarUrl, displayName: user.displayName, avatarClass: 'rank-img' } only %}
                            <div class="rank-user-data">
                                <span class="name">{{ user.displayName }}</span>
                                <span class="xp">{{ user.xp }} XP &middot; {{ user.levelBadge.fullTitle }} &middot; Level {{ user.level }}</span>
                            </div>
                        </a>
                    {% else %}
                        <div class="rank-info">
                            {% include 'components/user_avatar.html.twig' with { avatarUrl: user.avatarUrl, displayName: user.displayName, avatarClass: 'rank-img' } only %}
                            <div class="rank-user-data">
                                <span class="name">{{ user.displayName }}</span>
                                <span class="xp">{{ user.xp }} XP &middot; {{ user.levelBadge.fullTitle }} &middot; Level {{ user.level }}</span>
                            </div>
                        </div>
                    {% endif %}

                    {% if currentUser and currentUser.id == user.userId %}
                        <span class="badge-pill badge-top">{{ 'leaderboard.you'|trans }}</span>
                    {% else %}
                        <span class="badge-pill badge-s">#{{ position }}</span>
                    {% endif %}
                </div>
            {% else %}
                <div class="rank-item">
                    <div class="rank-info">
                        <div class="rank-user-data">
                            <span class="name">{{ 'leaderboard.empty_title'|trans }}</span>
                            <span class="xp">{{ 'leaderboard.empty_text'|trans }}</span>
                        </div>
                    </div>
                </div>
            {% endfor %}
        </div>
    </section>
    </div>
</div>
{% endblock %}


