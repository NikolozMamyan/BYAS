{% if notifications is empty %}
    <div class="notif-panel__empty">
        <i class="fas fa-bell"></i>
        <div>{{ 'notifications.empty_title'|trans }}</div>
    </div>
{% else %}
    <div class="notif-panel__head">
        <div>
            <strong>{{ 'notifications.title'|trans }}</strong>
            <div class="notif-panel__muted">{{ 'notifications.unread_count'|trans({ '%count%': unreadCount }) }}</div>
        </div>
        <a href="{{ path('app_front_notifications') }}" class="notif-panel__link">{{ 'notifications.view_all'|trans }}</a>
    </div>
    <div class="notif-panel__list">
        {% for notification in notifications %}
            {% include 'front/notifications/_item.html.twig' with { notification: notification, compact: true } only %}
        {% endfor %}
    </div>
    <div class="notif-panel__footer">
        <a href="{{ path('app_front_notifications') }}" class="notif-panel__button">{{ 'notifications.open_inbox'|trans }}</a>
    </div>
{% endif %}
