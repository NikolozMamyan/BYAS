{% extends 'base.html.twig' %}

{% block title %}BYAS | {{ 'notifications.title'|trans }}{% endblock %}

{% block stylesheets %}
{{ parent() }}
<link rel="stylesheet" href="{{ asset('styles/front/notifications.css') }}">
{% endblock %}

{% block body %}
<main class="notifications-page">
    <section class="hero">
        <div class="hero-top">
            <div>
                <div class="kicker">{{ 'notifications.title'|trans }}</div>
                <h1>{{ 'notifications.inbox'|trans }}</h1>
            </div>
            {% if unreadCount > 0 %}
                <form method="post" action="{{ path('app_front_notifications_mark_all_read') }}">
                    <input type="hidden" name="_token" value="{{ csrf_token('mark_all_notifications_read') }}">
                    <button type="submit" class="mark-read-btn">{{ 'notifications.mark_all_read'|trans }}</button>
                </form>
            {% endif %}
        </div>
        <p class="muted">{{ 'notifications.subtitle'|trans }}</p>
    </section>

    <section class="stats">
        <div class="stat">
            <small>{{ 'notifications.total'|trans }}</small>
            <strong>{{ notificationCount }}</strong>
        </div>
        <div class="stat">
            <small>{{ 'notifications.unread'|trans }}</small>
            <strong>{{ unreadCount }}</strong>
        </div>
        <div class="stat">
            <small>{{ 'notifications.read'|trans }}</small>
            <strong>{{ notificationCount - unreadCount }}</strong>
        </div>
    </section>

    <section class="feed-shell">
        <div class="feed-head">
            <h2>{{ 'notifications.recent_activity'|trans }}</h2>
            <span class="muted">{{ 'notifications.events_count'|trans({ '%count%': notifications|length }) }}</span>
        </div>

        <div class="feed-list">
            {% for notification in notifications %}
                {% include 'front/notifications/_item.html.twig' with { notification: notification, compact: false, allowDelete: true } only %}
            {% else %}
                <article class="feed-item">
                    <div class="feed-icon feed-icon--public-visit">
                        <i class="fas fa-bell"></i>
                    </div>
                    <div class="feed-content">
                        <div class="feed-title">{{ 'notifications.empty_title'|trans }}</div>
                        <div class="muted">{{ 'notifications.empty_text'|trans }}</div>
                    </div>
                </article>
            {% endfor %}
        </div>
    </section>
</main>
{% endblock %}
