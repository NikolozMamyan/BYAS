{% extends 'base.html.twig' %}

{% block title %}BYAS | {{ profile.username|default(user.displayName) }}{% endblock %}

{% block stylesheets %}
{{ parent() }}
<link rel="stylesheet" href="{{ asset('styles/front/passport-public.css') }}">
{% endblock %}

{% block body %}
{% set displayName = profile.username|default(user.displayName) %}
<main class="public-passport">
    <div class="public-top">
        <div class="public-top-left">
            <a
                href="{{ path('app_landing') }}"
                class="back-link"
                data-controller="back-nav"
                data-back-nav-fallback-value="{{ path('app_landing') }}"
                data-action="click->back-nav#go"
                aria-label="{{ 'common.go_back'|trans }}"
            >
                <i class="fas fa-arrow-left"></i>
            </a>
            <a href="{{ path('app_landing') }}" class="brand">BYAS</a>
        </div>
        <span class="public-label">{{ 'public_passport.label'|trans }}</span>
    </div>

    {% if isPrivate %}
        <section class="private-box">
            <div class="cta-card">
                <div class="private-identity">
                    {% include 'components/user_avatar.html.twig' with { avatarUrl: user.avatarUrl, displayName: displayName, avatarClass: 'avatar' } only %}
                    <div>
                        <h1>{{ displayName }}</h1>
                        <p class="muted">{{ 'public_passport.account_private'|trans }}</p>
                    </div>
                </div>
                <p class="muted">{{ 'public_passport.private_text'|trans }}</p>
                <a href="{{ path('show_register') }}">{{ 'public_passport.create_cta'|trans }}</a>
            </div>
        </section>
    {% else %}
        <section class="passport-card">
            <div class="identity">
                {% include 'components/user_avatar.html.twig' with { avatarUrl: user.avatarUrl, displayName: displayName, avatarClass: 'avatar' } only %}
                <div>
                    <h1>{{ displayName }}</h1>
                    <p class="muted">{{ globalLevelBadge.fullTitle }} · Level {{ user.globalLevel }} · {{ user.globalXp }} XP</p>
                </div>
            </div>

            <div class="stats">
                <div class="stat">
                    <small>{{ 'public_passport.global_rank'|trans }}</small>
                    <strong>{{ globalRank ? '#' ~ globalRank : ('public_passport.hidden'|trans) }}</strong>
                </div>
                <div class="stat">
                    <small>{{ 'public_passport.top_fandom'|trans }}</small>
                    <strong>{{ profile.isShowFandomLevels() ? (fandoms|length and fandoms[0].artist ? fandoms[0].artist.name : ('public_passport.none_yet'|trans)) : ('public_passport.hidden'|trans) }}</strong>
                </div>
                <div class="stat">
                    <small>{{ 'public_passport.badges'|trans }}</small>
                    <strong>{{ profile.isShowBadges() ? userBadges|length : ('public_passport.hidden'|trans) }}</strong>
                </div>
            </div>

            <div class="xp-bar" aria-label="{{ 'public_passport.global_progress'|trans }}">
                <span style="width: {{ globalProgress.percent }}%;"></span>
            </div>
        </section>

        {% if profile.isShowFandomLevels() %}
            <section class="section-card">
                <div class="section-head">
                    <h2>{{ 'public_passport.top_fandoms'|trans }}</h2>
                    <span class="pill">{{ fandoms|length }}</span>
                </div>
                <div class="list">
                    {% for fandom in fandoms %}
                        <div class="row">
                            <div>
                                <strong>{{ fandom.artist ? fandom.artist.name : ('passport.artist_fallback'|trans) }}</strong>
                                <span class="muted">{{ fandom.xp }} XP</span>
                            </div>
                            <span class="pill">{{ attribute(fandomLevelBadges, fandom.id).fullTitle }} · {{ 'passport.level_short'|trans }} {{ fandom.level }}</span>
                        </div>
                    {% else %}
                        <div class="row">
                            <span class="muted">{{ 'public_passport.no_fandom'|trans }}</span>
                        </div>
                    {% endfor %}
                </div>
            </section>
        {% endif %}

        {% if profile.isShowBadges() %}
            <section class="section-card">
                <div class="section-head">
                    <h2>{{ 'public_passport.badges'|trans }}</h2>
                    <span class="pill">{{ userBadges|length }}</span>
                </div>
                <div class="list">
                    {% for userBadge in userBadges %}
                        <div class="row">
                            <div>
                                <strong>{{ userBadge.badge.name }}</strong>
                                <span class="muted">{{ userBadge.awardedAt|date('M d, Y') }}</span>
                            </div>
                            <span class="pill">{{ 'public_passport.earned'|trans }}</span>
                        </div>
                    {% else %}
                        <div class="row">
                            <span class="muted">{{ 'public_passport.no_badge'|trans }}</span>
                        </div>
                    {% endfor %}
                </div>
            </section>
        {% endif %}

        {% if profile.isShowCollection() %}
            <section class="section-card">
                <div class="section-head">
                    <h2>{{ 'public_passport.collection'|trans }}</h2>
                    <span class="pill">{{ collectionItems|length }}</span>
                </div>
                <div class="list">
                    {% for item in collectionItems %}
                        <div class="row">
                            <div>
                                <strong>{{ item.title }}</strong>
                                <span class="muted">{{ item.type ? item.type.label : ('public_passport.collection_item'|trans) }}{% if item.artist %} - {{ item.artist.name }}{% endif %}</span>
                            </div>
                            <span class="pill">x{{ item.quantity }}</span>
                        </div>
                    {% else %}
                        <div class="row">
                            <span class="muted">{{ 'public_passport.no_collection_item'|trans }}</span>
                        </div>
                    {% endfor %}
                </div>
            </section>
        {% endif %}

        <section class="cta-card">
            {% if isOwner %}
                <strong>{{ 'public_passport.owner_title'|trans }}</strong>
                <p class="muted">{{ 'public_passport.owner_text'|trans }}</p>
                <a href="{{ path('app_front_passport_settings') }}">{{ 'public_passport.owner_cta'|trans }}</a>
            {% else %}
                <strong>{{ 'public_passport.message_title'|trans({ '%name%': displayName }) }}</strong>
                <p class="muted">{{ 'public_passport.message_text'|trans }}</p>
                <a href="{{ path('app_public_passport_message', { shareSlug: profile.shareSlug }) }}">{{ 'public_passport.message_cta'|trans }}</a>
            {% endif %}
        </section>
    {% endif %}
</main>
{% endblock %}
