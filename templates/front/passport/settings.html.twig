{% extends 'base.html.twig' %}

{% block title %}BYAS | {{ 'settings.title_short'|trans }}{% endblock %}

{% block stylesheets %}
{{ parent() }}
<link rel="stylesheet" href="{{ asset('styles/front/passport-settings.css') }}">
{% endblock %}

{% block body %}
<main class="settings-page">
    <section class="panel hero">
        <div class="kicker">{{ 'settings.kicker'|trans }}</div>
        <h1>{{ 'settings.hero_title'|trans }}</h1>
        <p class="muted">{{ 'settings.hero_subtitle'|trans }}</p>
        {% include 'components/language_switcher.html.twig' with { id: 'settingsLocaleSwitcher' } only %}
    </section>

    {% for message in app.flashes('success') %}
        <div class="flash flash-success">{{ message }}</div>
    {% endfor %}
    {% for message in app.flashes('error') %}
        <div class="flash flash-error">{{ message }}</div>
    {% endfor %}

    <form method="post" enctype="multipart/form-data" class="panel form-grid">
        <input type="hidden" name="_token" value="{{ csrf_token('passport_settings') }}">

        <section class="account-grid">
            <div class="avatar-card">
                {% include 'components/user_avatar.html.twig' with {
                    avatarUrl: user.avatarUrl,
                    displayName: profile.username|default(user.displayName),
                    avatarClass: user.avatarUrl ? 'avatar-frame' : 'avatar-frame'
                } only %}
                <div class="field field--full">
                    <label for="avatar">{{ 'settings.account.avatar'|trans }}</label>
                    <input class="file" id="avatar" type="file" name="avatar" accept="image/png,image/jpeg,image/webp,image/gif">
                </div>
                {% if user.avatarUrl %}
                    <button class="btn btn-danger" type="submit" name="action" value="remove_avatar">{{ 'settings.account.remove_avatar'|trans }}</button>
                {% endif %}
            </div>

            <div class="form-grid">
                <h2>{{ 'settings.account.section'|trans }}</h2>
                <div class="fields-2">
                    <div class="field">
                        <label for="firstName">{{ 'settings.account.first_name'|trans }}</label>
                        <input class="input" id="firstName" name="firstName" value="{{ user.firstName|default('') }}">
                    </div>
                    <div class="field">
                        <label for="lastName">{{ 'settings.account.last_name'|trans }}</label>
                        <input class="input" id="lastName" name="lastName" value="{{ user.lastName|default('') }}">
                    </div>
                </div>
                <div class="field">
                    <label for="displayName">{{ 'settings.account.display_name'|trans }}</label>
                    <input class="input" id="displayName" name="displayName" value="{{ user.displayName }}">
                </div>
                <div class="field">
                    <label>{{ 'settings.account.email'|trans }}</label>
                    <input class="input" value="{{ user.email }}" disabled>
                </div>
            </div>
        </section>

        <section class="form-grid">
            <h2>{{ 'settings.public_passport.section'|trans }}</h2>
            <div class="field" data-controller="clipboard" data-clipboard-copied-label-value="{{ 'common.copied'|trans }}" data-clipboard-default-label-value="{{ 'common.copy_link'|trans }}">
                <label for="publicPassportUrl">{{ 'settings.public_passport.public_link'|trans }}</label>
                <input class="link-box" id="publicPassportUrl" value="{{ publicUrl }}" data-clipboard-target="source" readonly>
                <div class="actions">
                    <a class="btn" href="{{ publicUrl }}" target="_blank" rel="noopener">{{ 'common.preview'|trans }}</a>
                    <button class="btn" type="button" data-clipboard-target="button" data-action="clipboard#copy">{{ 'common.copy_link'|trans }}</button>
                    <a class="btn" href="{{ path('app_front_passport_share') }}">{{ 'settings.public_passport.generate_share_card'|trans }}</a>
                </div>
            </div>

            <label class="switch-row">
                <span>
                    <strong>{{ 'settings.public_passport.public_passport'|trans }}</strong>
                    <span class="muted">{{ 'settings.public_passport.public_passport_help'|trans }}</span>
                </span>
                <span class="switch">
                    <input type="checkbox" name="isProfilePublic" {{ profile.isProfilePublic() ? 'checked' : '' }}>
                    <span class="slider"></span>
                </span>
            </label>

            <label class="switch-row">
                <span>
                    <strong>{{ 'settings.public_passport.global_rank'|trans }}</strong>
                    <span class="muted">{{ 'settings.public_passport.global_rank_help'|trans }}</span>
                </span>
                <span class="switch">
                    <input type="checkbox" name="showGlobalRank" {{ profile.isShowGlobalRank() ? 'checked' : '' }}>
                    <span class="slider"></span>
                </span>
            </label>

            <label class="switch-row">
                <span>
                    <strong>{{ 'settings.public_passport.fandom_levels'|trans }}</strong>
                    <span class="muted">{{ 'settings.public_passport.fandom_levels_help'|trans }}</span>
                </span>
                <span class="switch">
                    <input type="checkbox" name="showFandomLevels" {{ profile.isShowFandomLevels() ? 'checked' : '' }}>
                    <span class="slider"></span>
                </span>
            </label>

            <label class="switch-row">
                <span>
                    <strong>{{ 'settings.public_passport.badges'|trans }}</strong>
                    <span class="muted">{{ 'settings.public_passport.badges_help'|trans }}</span>
                </span>
                <span class="switch">
                    <input type="checkbox" name="showBadges" {{ profile.isShowBadges() ? 'checked' : '' }}>
                    <span class="slider"></span>
                </span>
            </label>

            <label class="switch-row">
                <span>
                    <strong>{{ 'settings.public_passport.collection'|trans }}</strong>
                    <span class="muted">{{ 'settings.public_passport.collection_help'|trans }}</span>
                </span>
                <span class="switch">
                    <input type="checkbox" name="showCollection" {{ profile.isShowCollection() ? 'checked' : '' }}>
                    <span class="slider"></span>
                </span>
            </label>
        </section>

        <section class="form-grid">
            <h2>{{ 'settings.identity_sources.section'|trans }}</h2>
            {% for account in oauthAccounts %}
                <div class="action-row">
                    <div>
                        <strong>{{ account.provider|capitalize }}</strong>
                        <div class="muted">{{ account.email }}</div>
                    </div>
                    <span class="btn">{{ 'settings.identity_sources.linked'|trans }}</span>
                </div>
            {% endfor %}

            {% if spotifyAccount and spotifyAccount.connected %}
                <div class="action-row">
                    <div>
                        <strong>{{ 'settings.identity_sources.spotify'|trans }}</strong>
                        <div class="muted">{{ spotifyAccount.displayName|default(spotifyAccount.providerUserId) }}</div>
                    </div>
                    <button type="submit" class="btn" formaction="{{ path('app_spotify_disconnect') }}" formmethod="post">{{ 'common.disconnect'|trans }}</button>
                </div>
            {% else %}
                <div class="action-row">
                    <div>
                        <strong>{{ 'settings.identity_sources.spotify'|trans }}</strong>
                        <div class="muted">{{ 'settings.identity_sources.spotify_help'|trans }}</div>
                    </div>
                    <a class="btn" href="{{ path('app_spotify_start') }}">{{ 'settings.identity_sources.spotify_connect'|trans }}</a>
                </div>
            {% endif %}

            {# {% if appleMusicAccount and appleMusicAccount.connected %}
                <div class="action-row">
                    <div>
                        <strong>Apple Music</strong>
                        <div class="muted">{{ appleMusicAccount.displayName|default(appleMusicAccount.providerUserId) }}</div>
                    </div>
                    <button type="submit" class="btn" formaction="{{ path('app_apple_music_disconnect') }}" formmethod="post">Disconnect</button>
                </div>
            {% else %}
                <div class="action-row">
                    <div>
                        <strong>Apple Music</strong>
                        <div class="muted">Connect your recent Apple Music listening</div>
                    </div>
                    <a class="btn" href="{{ path('app_apple_music_start') }}">Connect Apple Music</a>
                </div>
            {% endif %} #}

            {% if youtubeAccount and youtubeAccount.connected %}
                <div class="action-row">
                    <div>
                        <strong>{{ 'settings.identity_sources.youtube'|trans }}</strong>
                        <div class="muted">{{ youtubeAccount.displayName|default(youtubeAccount.providerUserId) }}</div>
                    </div>
                    <button type="submit" class="btn" formaction="{{ path('app_youtube_disconnect') }}" formmethod="post">{{ 'common.disconnect'|trans }}</button>
                </div>
            {% else %}
                <div class="action-row">
                    <div>
                        <strong>{{ 'settings.identity_sources.youtube'|trans }}</strong>
                        <div class="muted">{{ 'settings.identity_sources.youtube_help'|trans }}</div>
                    </div>
                    <a class="btn" href="{{ path('app_youtube_start') }}">{{ 'settings.identity_sources.youtube_connect'|trans }}</a>
                </div>
            {% endif %}
        </section>

        <div class="actions">
            <a class="btn" href="{{ path('app_front_passport') }}">{{ 'common.back'|trans }}</a>
            <button class="btn btn-primary" type="submit" name="action" value="save_settings">{{ 'settings.save'|trans }}</button>
        </div>
    </form>

    <section class="panel settings-danger-zone">
        <div class="settings-danger-zone__copy">
            <h2>{{ 'settings.logout.section'|trans }}</h2>
            <p class="muted">{{ 'settings.logout.text'|trans }}</p>
        </div>
        <form method="post" action="{{ path('app_front_logout') }}" class="settings-danger-zone__form">
            <button class="btn btn-danger" type="submit">{{ 'settings.logout.submit'|trans }}</button>
        </form>
    </section>
</main>
{% endblock %}
