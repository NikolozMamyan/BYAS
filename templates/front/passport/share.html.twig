{% extends 'base.html.twig' %}

{% block title %}BYAS | {{ 'share_card.title'|trans }}{% endblock %}

{% block stylesheets %}
{{ parent() }}
<link rel="stylesheet" href="{{ asset('styles/front/passport-share.css') }}">
{% endblock %}

{% block body %}
{% set displayName = profile.username|default(user.displayName) %}
<main
    class="share-page"
    data-controller="share-export"
    data-share-export-url-value="{{ shareUrl }}"
    data-share-export-loading-message-value="{{ 'share_card.status.loading'|trans }}"
    data-share-export-rendering-label-value="{{ 'share_card.status.rendering_label'|trans }}"
    data-share-export-rendering-message-value="{{ 'share_card.status.rendering'|trans }}"
    data-share-export-failed-message-value="{{ 'share_card.status.failed'|trans }}"
    data-share-export-download-label-value="{{ 'share_card.download_png'|trans }}"
    data-share-export-ready-message-value="{{ 'share_card.status.ready'|trans }}"
    data-share-export-qr-fallback-label-value="{{ 'share_card.qr_fallback'|trans }}"
>
    <div class="share-topbar">
        <a
            href="{{ path('app_front_passport') }}"
            class="back-link"
            data-controller="back-nav"
            data-back-nav-fallback-value="{{ path('app_front_passport') }}"
            data-action="click->back-nav#go"
            aria-label="{{ 'common.go_back'|trans }}"
        >
            <i class="fas fa-arrow-left"></i>
        </a>
    </div>

    <section class="story-card" id="shareCard" data-share-export-target="card">
        <div class="share-top">
            <div class="brand">BYAS</div>
            <div class="rank-pill">Global #{{ globalRank }}</div>
        </div>

        <div class="hero-zone">
            <div class="identity-row">
                {% include 'components/user_avatar.html.twig' with {
                    avatarUrl: user.avatarUrl,
                    displayName: displayName,
                    avatarClass: 'avatar-media'
                } only %}
                <div>
                    <h1 class="name">{{ displayName }}</h1>
                    <div class="level">{{ globalLevelBadge.fullTitle }} &middot; Level {{ user.globalLevel }} &middot; {{ user.globalXp }} XP</div>
                </div>
            </div>

            <div class="xp-panel">
                <div class="xp-head">
                    <span>{{ 'share_card.global_progress'|trans }}</span>
                    <span>{{ globalProgress.percent|round }}%</span>
                </div>
                <div class="xp-bar" aria-label="{{ 'share_card.global_progress'|trans }}">
                    <span style="width: {{ globalProgress.percent }}%;"></span>
                </div>
            </div>

            <div>
                <div class="share-stats">
                    <div class="share-stat">
                        <small>{{ 'share_card.top_fandom'|trans }}</small>
                        <strong>{{ topFandom and topFandom.artist ? topFandom.artist.name : ('share_card.no_fandom'|trans) }}</strong>
                    </div>
                    <div class="share-stat">
                        <small>{{ 'share_card.fandom_level'|trans }}</small>
                        <strong>{{ topFandomLevelBadge ? topFandomLevelBadge.fullTitle ~ ' · Lv ' ~ topFandom.level : '-' }}</strong>
                    </div>
                </div>

                <div class="badge-row">
                    {% for userBadge in userBadges %}
                        <span class="badge">{{ userBadge.badge.name }}</span>
                    {% else %}
                        <span class="badge">{{ 'share_card.first_badge_loading'|trans }}</span>
                    {% endfor %}
                </div>
            </div>
        </div>

        <div class="story-bottom">
            <div class="caption">{{ 'share_card.caption'|trans }}</div>
            <div class="qr-box" id="shareQr" aria-label="{{ 'share_card.qr_code'|trans }}" data-share-export-target="qr"></div>
        </div>
    </section>

    <div class="share-actions">
        <a href="{{ path('app_front_passport') }}">{{ 'share_card.back_to_passport'|trans }}</a>
        <button type="button" class="primary" id="downloadStory" data-share-export-target="download" data-action="share-export#download">{{ 'share_card.download_png'|trans }}</button>
        {# <button type="button" data-action="share-export#print">Save as PDF</button> #}
    </div>

    <p class="share-note" id="shareExportStatus" data-share-export-target="status">{{ 'share_card.note'|trans }}</p>
</main>

<script src="https://cdn.jsdelivr.net/npm/qrcodejs@1.0.0/qrcode.min.js"></script>
<script src="https://cdn.jsdelivr.net/npm/html2canvas@1.4.1/dist/html2canvas.min.js"></script>
{% endblock %}
