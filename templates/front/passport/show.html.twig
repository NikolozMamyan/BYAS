{% extends 'base.html.twig' %}

{% block title %}BYAS | {{ 'passport.title'|trans }}{% endblock %}

{% block stylesheets %}
    {{ parent() }}
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Orbitron:wght@500;700;800&family=Rajdhani:wght@500;600;700;800&display=swap" rel="stylesheet">
    <link rel="stylesheet" href="{{ asset('styles/front/passport-show.css') }}">
{% endblock %}

{% block body %}
{% set successFlashes = app.flashes('success') %}
{% set errorFlashes = app.flashes('error') %}
{% set passportAsset = 'img/passport/' %}
{% set displayName = profile.username|default(user.displayName) %}
{% set primaryFandomName = primaryFandom and primaryFandom.artist ? primaryFandom.artist.name : ('passport.byas_fan'|trans) %}
{% set topFandomXp = topFandoms|length ? topFandoms[0].xp : 0 %}
{% set badgeAssets = ['verified-badge.png', 'shield-star.png', 'weekly-star.png', 'trophy-heart.png', 'sparkle-core.png'] %}
<main
    class="passport-page native-screen is-hydrating"
    data-controller="screen-shell"
>
    <div class="screen-skeleton passport-screen-skeleton" aria-hidden="true">
        <div class="screen-skeleton__panel screen-skeleton__panel--hero">
            <div class="screen-skeleton__avatar"></div>
            <div class="screen-skeleton__copy">
                <span class="screen-skeleton__bar screen-skeleton__bar--lg"></span>
                <span class="screen-skeleton__bar screen-skeleton__bar--md"></span>
                <span class="screen-skeleton__bar screen-skeleton__bar--sm"></span>
                <span class="screen-skeleton__bar screen-skeleton__bar--full"></span>
            </div>
        </div>
        <div class="screen-skeleton__grid screen-skeleton__grid--three">
            <div class="screen-skeleton__card"></div>
            <div class="screen-skeleton__card"></div>
            <div class="screen-skeleton__card"></div>
        </div>
        <div class="screen-skeleton__grid screen-skeleton__grid--two">
            <div class="screen-skeleton__card"></div>
            <div class="screen-skeleton__card"></div>
        </div>
    </div>

    <div class="screen-content">
        <div class="passport-stack">
            <section class="passport-panel passport-hero">
                <div class="passport-panel__inner">
                    <div class="hero-main">
                        <div class="hero-avatar-wrap">
                            <div class="hero-avatar-ring">
                                {% include 'components/user_avatar.html.twig' with {
                                    avatarUrl: user.avatarUrl,
                                    displayName: displayName,
                                    avatarClass: 'hero-avatar'
                                } only %}
                            </div>
                            <a href="{{ path('app_front_passport_settings') }}" class="hero-avatar-edit" aria-label="{{ 'passport.edit'|trans }}">
                                <img src="{{ asset(passportAsset ~ 'edit-pencil.png') }}" alt="">
                            </a>
                        </div>

                        <div class="hero-copy">
                            <div class="hero-name-row">
                                <h1 class="hero-name">{{ displayName }}</h1>
                                <img class="hero-verified" src="{{ asset(passportAsset ~ 'verified-badge.png') }}" alt="">
                            </div>

                            <div class="hero-handle">
                                <i class="fas fa-heart"></i>
                                {{ primaryFandomName }}
                            </div>

                            <div class="hero-caption">{{ 'passport.base_level'|trans }}</div>
                            <div class="hero-level">{{ 'passport.level'|trans }} <span>{{ user.globalLevel }}</span></div>

                            <div class="hero-tier">
                                <img src="{{ asset(passportAsset ~ 'sparkle-core.png') }}" alt="">
                                {{ globalLevelBadge.fullTitle }}
                            </div>

                            <div class="hero-progress">
                                <div class="hero-progress__bar">
                                    <div class="hero-progress__fill" style="width: {{ globalProgress.percent }}%;"></div>
                                </div>
                                <div class="hero-progress__meta">
                                    {{ user.globalXp|number_format(0, '.', ',') }} / {{ globalProgress.next|default(user.globalXp)|number_format(0, '.', ',') }} XP
                                </div>
                            </div>

                        </div>
                    </div>
                </div>
            </section>

            {% if connectedSyncProviders is empty %}
                <section class="passport-panel streaming-onboarding" aria-labelledby="streamingOnboardingTitle">
                    <div class="passport-panel__inner streaming-onboarding__inner">
                        <div class="streaming-onboarding__icon">
                            <i class="fas fa-wave-square"></i>
                        </div>
                        <div class="streaming-onboarding__copy">
                            <div class="streaming-onboarding__kicker">{{ 'passport.streaming_onboarding.kicker'|trans }}</div>
                            <h2 id="streamingOnboardingTitle">{{ 'passport.streaming_onboarding.title'|trans }}</h2>
                            <p>{{ 'passport.streaming_onboarding.text'|trans }}</p>
                        </div>
                        <div class="streaming-onboarding__actions">
                            <a class="streaming-source streaming-source--spotify" href="{{ path('app_spotify_start') }}">
                                <i class="fab fa-spotify"></i>
                                <span>Spotify</span>
                            </a>
                            <a class="streaming-source streaming-source--youtube" href="{{ path('app_youtube_start') }}">
                                <i class="fab fa-youtube"></i>
                                <span>YouTube</span>
                            </a>
                        </div>
                    </div>
                </section>
            {% endif %}

            <section class="passport-panel">
                <div class="passport-panel__inner">
                    <div class="section-head">
                        <div class="section-title">
                            <img src="{{ asset(passportAsset ~ 'fandom-users.png') }}" alt="">
                            {{ 'passport.top_fandoms'|trans }}
                        </div>
                        <a href="{{ path('app_public_passport', { shareSlug: profile.shareSlug }) }}" class="section-link">{{ 'common.view_all'|trans }} <i class="fas fa-chevron-right"></i></a>
                    </div>

                    {% if topFandoms is not empty %}
                        <div class="fandom-grid">
                            {% for fandom in topFandoms %}
                                {% set fandomBadge = attribute(fandomLevelBadges, fandom.id) %}
                                {% set fandomRank = attribute(fandomRanks, fandom.id) %}
                                {% set fandomName = fandom.artist ? fandom.artist.name : ('passport.artist_fallback'|trans) %}
                                {% set fandomImage = fandom.artist ? fandom.artist.coverImageUrl : null %}
                                {% set fandomPercent = topFandomXp > 0 ? ((fandom.xp / topFandomXp) * 100)|round(0, 'floor') : 100 %}
                                <article class="fandom-card fandom-card--rank-{{ loop.index }}">
                                    <div class="fandom-rank{% if loop.index == 2 %} fandom-rank--secondary{% elseif loop.index == 3 %} fandom-rank--tertiary{% endif %}">{{ loop.index }}</div>
                                    <div class="fandom-mark">
                                        {% if fandomImage %}
                                            <img src="{{ fandomImage starts with 'http' ? fandomImage : asset(fandomImage) }}" alt="{{ fandomName }}">
                                        {% else %}
                                            <span>{{ fandomName|slice(0, 2)|upper }}</span>
                                        {% endif %}
                                    </div>
                                    <div class="fandom-copy">
                                        <div class="fandom-artist">{{ fandomName }}</div>
                                        <div class="fandom-title">
                                            <i class="fas fa-heart"></i>
                                            {{ fandomBadge.fullTitle }}
                                        </div>
                                    </div>
                                    <div class="fandom-meta">
                                        <span>{{ 'passport.level'|trans }} {{ fandom.level }}</span>
                                        <span>{{ fandomRank ? '#' ~ fandomRank : fandom.xp|number_format(0, '.', ',') ~ ' XP' }}</span>
                                    </div>
                                    <div class="fandom-line">
                                        <span style="width: {{ fandomPercent }}%;"></span>
                                    </div>
                                </article>
                            {% endfor %}
                        </div>
                    {% else %}
                        <div class="empty-state">{{ 'passport.empty_fandoms'|trans }}</div>
                    {% endif %}
                </div>
            </section>

            <section class="passport-panel">
                <div class="passport-panel__inner">
                    <div class="section-head">
                        <div class="section-title">
                            <img src="{{ asset(passportAsset ~ 'collection-stack.png') }}" alt="">
                            {{ 'passport.collection_mine'|trans }}
                        </div>
                        <a href="{{ path('app_front_collection_index') }}" class="section-link">{{ 'common.view_all'|trans }} <i class="fas fa-chevron-right"></i></a>
                    </div>

                    {% if collectionHighlights is not empty %}
                        <div class="collection-grid">
                            {% for highlight in collectionHighlights %}
                                {% set labelKey = highlight.label|lower %}
                                {% set collectionAsset = 'collection-stack.png' %}
                                {% if 'light' in labelKey %}
                                    {% set collectionAsset = 'lightstick.png' %}
                                {% elseif 'photo' in labelKey or 'card' in labelKey %}
                                    {% set collectionAsset = 'photocard.png' %}
                                {% elseif 'event' in labelKey %}
                                    {% set collectionAsset = 'event-ticket.png' %}
                                {% elseif 'album' in labelKey or 'vinyl' in labelKey or 'cd' in labelKey %}
                                    {% set collectionAsset = 'album-note.png' %}
                                {% endif %}
                                <article class="collection-card">
                                    <img src="{{ asset(passportAsset ~ collectionAsset) }}" alt="">
                                    <div class="collection-value">
                                        {{ highlight.count > 0 ? highlight.count|number_format(0, '.', ',') : ('passport.add_your_first'|trans) }}
                                    </div>
                                    <div class="collection-label">{{ highlight.label }}</div>
                                </article>
                            {% endfor %}
                        </div>
                    {% else %}
                        <div class="empty-state">{{ 'passport.empty_collection'|trans }}</div>
                    {% endif %}
                </div>
            </section>

            <section class="passport-panel">
                <div class="passport-panel__inner">
                    <div class="section-head">
                        <div class="section-title">
                            <img src="{{ asset(passportAsset ~ 'shield-star.png') }}" alt="">
                            {{ 'passport.rarest_badges'|trans }}
                        </div>
                        <span class="section-link">{{ 'passport.total_count'|trans({ '%count%': userBadges|length }) }}</span>
                    </div>

                    {% if featuredBadges is not empty %}
                        <div class="badge-grid">
                            {% for userBadge in featuredBadges %}
                                {% set badgeAsset = badgeAssets[loop.index0 % (badgeAssets|length)] %}
                                {% set badgeIcon = userBadge.badge.iconUrl %}
                                <details class="badge-card">
                                    <summary>
                                        <img
                                            class="badge-crest"
                                            src="{{ badgeIcon ? (badgeIcon starts with 'http' ? badgeIcon : asset(badgeIcon)) : asset(passportAsset ~ badgeAsset) }}"
                                            alt=""
                                        >
                                        <span class="badge-name">{{ userBadge.badge.name }}</span>
                                    </summary>
                                    <div class="badge-meta" role="tooltip">
                                        {{ userBadge.badge.description|default('passport.badge_default_description'|trans) }}
                                    </div>
                                </details>
                            {% endfor %}
                        </div>
                    {% else %}
                        <div class="empty-state">{{ 'passport.empty_badges'|trans }}</div>
                    {% endif %}
                </div>
            </section>

            <section class="passport-panel metric-strip" aria-label="{{ 'passport.title'|trans }}">
                <div class="passport-panel__inner metric-strip__inner">
                    <article class="metric-item">
                        <img src="{{ asset(passportAsset ~ 'weekly-star.png') }}" alt="">
                        <div>
                            <strong>+{{ passportMetrics.weeklyXp|number_format(0, '.', ',') }} XP</strong>
                            <span>{{ 'passport.this_week'|trans }}</span>
                        </div>
                    </article>
                    <article class="metric-item">
                        <img src="{{ asset(passportAsset ~ 'rank-up.png') }}" alt="">
                        <div>
                            <strong>{{ passportMetrics.weeklyRankGain is not null ? '↑ ' ~ passportMetrics.weeklyRankGain : '--' }}</strong>
                            <span>{{ 'passport.rank_this_week'|trans }}</span>
                        </div>
                    </article>
                    <article class="metric-item">
                        <img src="{{ asset(passportAsset ~ 'streaming-clock.png') }}" alt="">
                        <div>
                            <strong>{{ passportMetrics.weeklyListeningMinutes }} min</strong>
                            <span>{{ 'passport.streaming_this_week'|trans }}</span>
                        </div>
                    </article>
                    <article class="metric-item">
                        <img src="{{ asset(passportAsset ~ 'missions-target.png') }}" alt="">
                        <div>
                            <strong>{{ passportMetrics.missionCount ?? '--' }}</strong>
                            <span>{{ 'passport.missions'|trans }}</span>
                        </div>
                    </article>
                </div>
            </section>

            <div class="passport-focus-grid">
                <section class="passport-panel focus-card focus-card--level">
                    <div class="passport-panel__inner focus-card__inner">
                        <div class="focus-card__copy">
                            <div class="focus-card__label">
                                <img src="{{ asset(passportAsset ~ 'streak-flame-outline.png') }}" alt="">
                                {{ 'passport.streak'|trans }}
                            </div>
                            <div class="focus-card__value">{{ passportMetrics.currentStreak }}</div>
                            <div class="focus-card__title">{{ 'passport.day_streak'|trans }}</div>
                            <div class="focus-card__text">{{ 'passport.keep_it_going'|trans }}</div>
                        </div>
                        <img class="focus-card__art focus-card__art--flame" src="{{ asset(passportAsset ~ 'streak-flame.png') }}" alt="">
                    </div>
                </section>

                <section class="passport-panel focus-card focus-card--rank">
                    <div class="passport-panel__inner focus-card__inner">
                        <div class="focus-card__copy">
                            <div class="focus-card__label">
                                <img src="{{ asset(passportAsset ~ 'trophy-heart.png') }}" alt="">
                                {{ 'passport.global_rank'|trans }}
                            </div>
                            <div class="rank-list">
                                <div><strong>{{ globalRank ? '#' ~ globalRank : '--' }}</strong><span>{{ 'passport.global_scope'|trans }}</span></div>
                                <div><strong>{{ passportMetrics.countryRank ? '#' ~ passportMetrics.countryRank : '--' }}</strong><span>{{ profile.countryCode|default('passport.country_scope'|trans) }}</span></div>
                                <div><strong>{{ passportMetrics.firstFandomRank ? '#' ~ passportMetrics.firstFandomRank : '--' }}</strong><span>{{ passportMetrics.firstFandomName|default(primaryFandomName) }}</span></div>
                            </div>
                        </div>
                        <img class="focus-card__art focus-card__art--globe" src="{{ asset(passportAsset ~ 'rank-globe.png') }}" alt="">
                    </div>
                </section>
            </div>

            {% if successFlashes is not empty %}
                <div class="flash-grid">
                    {% for message in successFlashes %}
                        <div class="flash-card flash-card--success">{{ message }}</div>
                    {% endfor %}
                </div>
            {% endif %}

            {% if errorFlashes is not empty %}
                <div class="flash-grid">
                    {% for message in errorFlashes %}
                        <div class="flash-card flash-card--error">{{ message }}</div>
                    {% endfor %}
                </div>
            {% endif %}
        </div>
    </div>
</main>
{% endblock %}
