{% extends 'base.html.twig' %}

{% block title %}BYAS | {{ 'passport.title'|trans }}{% endblock %}

{% block stylesheets %}
    {{ parent() }}
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Orbitron:wght@500;700;800&family=Rajdhani:wght@500;600;700&display=swap" rel="stylesheet">
{% endblock %}

{% block page_styles %}
    <style>
        body {
            background:
                radial-gradient(circle at 18% 12%, rgba(74, 72, 235, 0.28), transparent 26%),
                radial-gradient(circle at 78% 14%, rgba(248, 60, 176, 0.18), transparent 24%),
                radial-gradient(circle at 50% 80%, rgba(99, 22, 208, 0.22), transparent 30%),
                var(--bg);
        }

        .passport-page {
            position: relative;
            max-width: 980px;
            margin: 0 auto;
            padding: 92px 14px 108px;
        }

        .passport-page::before {
            content: "";
            position: absolute;
            inset: 0 auto auto 50%;
            width: min(560px, 90vw);
            height: 560px;
            transform: translateX(-50%);
            background:
                radial-gradient(circle, rgba(99, 22, 208, 0.28) 0%, rgba(99, 22, 208, 0) 65%);
            filter: blur(18px);
            pointer-events: none;
            z-index: 0;
        }

        .passport-stack {
            position: relative;
            z-index: 1;
            display: grid;
            gap: 14px;
        }

        .passport-panel {
            position: relative;
            overflow: hidden;
            border-radius: 20px;
            padding: 1px;
            background: linear-gradient(135deg, rgba(74, 72, 235, 0.82), rgba(99, 22, 208, 0.45), rgba(248, 60, 176, 0.7));
            box-shadow: 0 22px 52px rgba(2, 0, 12, 0.62);
        }

        .passport-panel::before {
            content: "";
            position: absolute;
            inset: 0;
            background:
                radial-gradient(circle at 14% 18%, rgba(255, 255, 255, 0.16), transparent 14%),
                radial-gradient(circle at 70% 30%, rgba(255, 255, 255, 0.08), transparent 18%),
                radial-gradient(circle at 82% 80%, rgba(248, 60, 176, 0.18), transparent 20%);
            opacity: 0.75;
            pointer-events: none;
        }

        .passport-panel__inner {
            position: relative;
            z-index: 1;
            border-radius: 19px;
            padding: 16px;
            background:
                linear-gradient(180deg, rgba(10, 7, 24, 0.96) 0%, rgba(7, 5, 20, 0.98) 100%);
            border: 1px solid rgba(255, 255, 255, 0.06);
        }

        .hero-grid {
            display: grid;
            gap: 16px;
        }

        .hero-main {
            display: grid;
            grid-template-columns: 112px minmax(0, 1fr);
            gap: 16px;
            align-items: center;
        }

        .hero-avatar-wrap {
            position: relative;
        }

        .hero-avatar-ring {
            width: 112px;
            height: 112px;
            border-radius: 50%;
            padding: 3px;
            background: linear-gradient(135deg, #7f84ff 0%, var(--pink) 100%);
            box-shadow:
                0 0 0 3px rgba(125, 83, 255, 0.2),
                0 0 30px rgba(116, 81, 255, 0.42);
        }

        .hero-avatar,
        .hero-avatar.avatar-placeholder {
            width: 100%;
            height: 100%;
            border-radius: 50%;
            object-fit: cover;
            border: 3px solid rgba(10, 7, 24, 0.95);
            display: grid;
            place-items: center;
            background: linear-gradient(135deg, rgba(248, 60, 176, 0.2), rgba(74, 72, 235, 0.28));
            color: white;
            font-size: 2rem;
            font-weight: 800;
        }

        .hero-avatar-edit {
            position: absolute;
            right: 2px;
            bottom: 4px;
            width: 30px;
            height: 30px;
            border: 1px solid rgba(255, 255, 255, 0.14);
            border-radius: 50%;
            background: rgba(10, 7, 24, 0.92);
            display: grid;
            place-items: center;
            color: white;
            text-decoration: none;
            box-shadow: 0 10px 20px rgba(0, 0, 0, 0.38);
        }

        .hero-copy {
            min-width: 0;
        }

        .hero-name-row {
            display: flex;
            align-items: center;
            gap: 8px;
            flex-wrap: wrap;
        }

        .hero-name {
            margin: 0;
            font-size: clamp(2rem, 4vw, 2.55rem);
            line-height: 0.92;
            letter-spacing: -0.03em;
            text-transform: uppercase;
        }

        .hero-verified {
            color: #a88cff;
            font-size: 0.95rem;
        }

        .hero-handle {
            display: inline-flex;
            align-items: center;
            gap: 8px;
            margin-top: 8px;
            padding: 6px 12px;
            border-radius: 999px;
            background: rgba(248, 60, 176, 0.12);
            border: 1px solid rgba(248, 60, 176, 0.24);
            color: #ff76c8;
            font: 700 0.82rem/1 'Rajdhani', sans-serif;
            letter-spacing: 0.04em;
            text-transform: uppercase;
        }

        .hero-caption {
            margin-top: 14px;
            color: rgba(255, 255, 255, 0.62);
            font: 600 0.72rem/1 'Rajdhani', sans-serif;
            text-transform: uppercase;
            letter-spacing: 0.16em;
        }

        .hero-level {
            margin-top: 4px;
            font-family: 'Orbitron', sans-serif;
            font-size: clamp(2rem, 5vw, 2.9rem);
            font-weight: 800;
            line-height: 1;
            color: #d9dbff;
            text-shadow: 0 0 24px rgba(120, 106, 255, 0.25);
        }

        .hero-level span {
            color: #7fb1ff;
        }

        .hero-tier {
            display: inline-flex;
            align-items: center;
            gap: 8px;
            margin-top: 10px;
            padding: 7px 12px;
            border-radius: 999px;
            background: rgba(99, 22, 208, 0.16);
            border: 1px solid rgba(99, 22, 208, 0.38);
            color: #f1d7ff;
            font: 700 0.84rem/1 'Rajdhani', sans-serif;
            text-transform: uppercase;
        }

        .hero-tier i {
            color: #96a5ff;
        }

        .hero-progress {
            margin-top: 16px;
        }

        .hero-progress__bar {
            height: 10px;
            border-radius: 999px;
            overflow: hidden;
            background: rgba(255, 255, 255, 0.06);
            border: 1px solid rgba(248, 60, 176, 0.2);
        }

        .hero-progress__fill {
            height: 100%;
            border-radius: inherit;
            background: linear-gradient(90deg, #4aa0ff 0%, #744dff 44%, #f83cb0 100%);
            box-shadow: 0 0 22px rgba(116, 77, 255, 0.46);
        }

        .hero-progress__meta {
            display: flex;
            justify-content: space-between;
            gap: 10px;
            margin-top: 8px;
            color: rgba(255, 255, 255, 0.76);
            font: 700 0.88rem/1 'Rajdhani', sans-serif;
        }

        .hero-actions {
            display: flex;
            gap: 10px;
            flex-wrap: wrap;
            margin-top: 14px;
        }

        .hero-btn {
            display: inline-flex;
            align-items: center;
            gap: 8px;
            padding: 10px 14px;
            border-radius: 12px;
            border: 1px solid rgba(255, 255, 255, 0.12);
            background: rgba(255, 255, 255, 0.04);
            color: white;
            text-decoration: none;
            font: 700 0.85rem/1 'Rajdhani', sans-serif;
            text-transform: uppercase;
            letter-spacing: 0.04em;
            cursor: pointer;
        }

        .hero-btn--primary {
            background: linear-gradient(90deg, rgba(74, 72, 235, 0.32), rgba(248, 60, 176, 0.24));
            border-color: rgba(132, 102, 255, 0.34);
            box-shadow: 0 12px 28px rgba(74, 72, 235, 0.2);
        }

        .stats-grid,
        .fandom-grid,
        .collection-grid,
        .badge-grid,
        .activity-grid,
        .flash-grid {
            display: grid;
            gap: 12px;
        }

        .stats-grid {
            grid-template-columns: repeat(3, minmax(0, 1fr));
        }

        .section-head {
            display: flex;
            align-items: center;
            justify-content: space-between;
            gap: 12px;
            margin-bottom: 12px;
        }

        .section-title {
            display: inline-flex;
            align-items: center;
            gap: 10px;
            font: 700 1rem/1 'Rajdhani', sans-serif;
            text-transform: uppercase;
            letter-spacing: 0.04em;
        }

        .section-link {
            color: rgba(255, 255, 255, 0.76);
            text-decoration: none;
            font: 700 0.86rem/1 'Rajdhani', sans-serif;
        }

        .stat-card,
        .fandom-card,
        .collection-card,
        .badge-card,
        .activity-card,
        .flash-card,
        .share-card {
            border-radius: 16px;
            border: 1px solid rgba(255, 255, 255, 0.08);
            background: linear-gradient(180deg, rgba(12, 8, 28, 0.92) 0%, rgba(8, 6, 22, 0.94) 100%);
        }

        .stat-card {
            padding: 16px;
            min-width: 0;
        }

        .stat-card__label {
            display: inline-flex;
            align-items: center;
            gap: 8px;
            color: rgba(255, 255, 255, 0.72);
            font: 700 0.82rem/1 'Rajdhani', sans-serif;
            text-transform: uppercase;
        }

        .stat-card__value {
            margin-top: 10px;
            font-family: 'Orbitron', sans-serif;
            font-size: clamp(1.6rem, 4vw, 2.15rem);
            color: #8fd2ff;
        }

        .stat-card__meta {
            margin-top: 8px;
            color: rgba(255, 255, 255, 0.55);
            font: 600 0.74rem/1.35 'Rajdhani', sans-serif;
            text-transform: uppercase;
        }

        .stat-card--accent .stat-card__value {
            color: #ff61c5;
        }

        .fandom-grid,
        .collection-grid,
        .badge-grid {
            grid-template-columns: repeat(3, minmax(0, 1fr));
        }

        .fandom-card,
        .badge-card {
            padding: 14px;
        }

        .fandom-rank {
            width: 28px;
            height: 28px;
            border-radius: 50%;
            display: grid;
            place-items: center;
            background: linear-gradient(135deg, var(--pink), #ff77cb);
            color: white;
            font: 800 0.82rem/1 'Orbitron', sans-serif;
            box-shadow: 0 0 18px rgba(248, 60, 176, 0.32);
        }

        .fandom-rank--secondary {
            background: linear-gradient(135deg, var(--cyan), #8e8cff);
            box-shadow: 0 0 18px rgba(74, 72, 235, 0.32);
        }

        .fandom-rank--tertiary {
            background: linear-gradient(135deg, #9d55ff, #6d4eff);
            box-shadow: 0 0 18px rgba(109, 78, 255, 0.28);
        }

        .fandom-head {
            display: flex;
            justify-content: space-between;
            gap: 12px;
            align-items: flex-start;
        }

        .fandom-artist {
            margin-top: 16px;
            font-weight: 700;
            text-transform: uppercase;
        }

        .fandom-title {
            margin-top: 4px;
            color: rgba(255, 255, 255, 0.62);
            font: 600 0.82rem/1.35 'Rajdhani', sans-serif;
        }

        .fandom-meta {
            display: flex;
            justify-content: space-between;
            gap: 8px;
            margin-top: 16px;
            color: #ff61c5;
            font: 700 0.84rem/1 'Rajdhani', sans-serif;
        }

        .fandom-meta span:last-child {
            color: #af88ff;
        }

        .fandom-line {
            height: 4px;
            border-radius: 999px;
            margin-top: 12px;
            background: linear-gradient(90deg, #f83cb0, #7e67ff);
            opacity: 0.95;
        }

        .collection-card {
            padding: 18px 16px;
            display: flex;
            align-items: center;
            gap: 14px;
            min-width: 0;
        }

        .collection-icon {
            width: 46px;
            height: 46px;
            border-radius: 14px;
            display: grid;
            place-items: center;
            background: linear-gradient(180deg, rgba(248, 60, 176, 0.18), rgba(74, 72, 235, 0.16));
            color: #ff5ec2;
            box-shadow: inset 0 0 0 1px rgba(248, 60, 176, 0.18), 0 0 18px rgba(99, 22, 208, 0.18);
            flex: 0 0 auto;
        }

        .collection-value {
            font-family: 'Orbitron', sans-serif;
            font-size: 2rem;
            line-height: 1;
        }

        .collection-label {
            margin-top: 6px;
            color: rgba(255, 255, 255, 0.74);
            font: 700 0.78rem/1 'Rajdhani', sans-serif;
            text-transform: uppercase;
        }

        .badge-card {
            text-align: center;
        }

        .badge-crest {
            width: 88px;
            height: 88px;
            margin: 0 auto 12px;
            border-radius: 24px;
            display: grid;
            place-items: center;
            background:
                radial-gradient(circle at 50% 35%, rgba(255, 255, 255, 0.18), transparent 24%),
                linear-gradient(180deg, rgba(126, 93, 255, 0.26) 0%, rgba(248, 60, 176, 0.18) 100%);
            border: 1px solid rgba(165, 145, 255, 0.26);
            box-shadow:
                inset 0 0 18px rgba(255, 255, 255, 0.08),
                0 0 24px rgba(116, 77, 255, 0.24);
            color: #f3d3ff;
            font-size: 2rem;
        }

        .badge-card:nth-child(3n) .badge-crest {
            background:
                radial-gradient(circle at 50% 35%, rgba(255, 255, 255, 0.2), transparent 24%),
                linear-gradient(180deg, rgba(255, 191, 92, 0.22) 0%, rgba(255, 133, 56, 0.14) 100%);
            border-color: rgba(255, 176, 86, 0.28);
            box-shadow:
                inset 0 0 18px rgba(255, 255, 255, 0.08),
                0 0 24px rgba(255, 150, 78, 0.2);
            color: #ffd28d;
        }

        .badge-name {
            display: inline-flex;
            align-items: center;
            justify-content: center;
            min-height: 32px;
            padding: 6px 12px;
            border-radius: 999px;
            border: 1px solid rgba(248, 60, 176, 0.18);
            color: #ff7fcf;
            font: 700 0.78rem/1 'Rajdhani', sans-serif;
            text-transform: uppercase;
        }

        .badge-meta {
            margin-top: 10px;
            color: rgba(255, 255, 255, 0.68);
            font: 600 0.8rem/1.35 'Rajdhani', sans-serif;
        }

        .share-card {
            display: grid;
            grid-template-columns: 92px minmax(0, 1fr) 120px;
            gap: 14px;
            padding: 16px;
            align-items: center;
        }

        .share-qr {
            width: 92px;
            height: 92px;
            border-radius: 14px;
            padding: 8px;
            background: white;
            display: grid;
            place-items: center;
            color: #05050a;
            font-size: 2rem;
        }

        .share-title {
            font: 800 1.05rem/1.1 'Rajdhani', sans-serif;
            text-transform: uppercase;
        }

        .share-text {
            margin-top: 6px;
            color: rgba(255, 255, 255, 0.68);
            font: 600 0.84rem/1.4 'Rajdhani', sans-serif;
        }

        .share-link-row {
            display: flex;
            gap: 10px;
            flex-wrap: wrap;
            margin-top: 12px;
        }

        .share-mini {
            display: grid;
            place-items: center;
            min-height: 92px;
            border-radius: 16px;
            background:
                linear-gradient(160deg, rgba(15, 11, 36, 0.96), rgba(28, 13, 58, 0.96));
            border: 1px solid rgba(138, 104, 255, 0.28);
            box-shadow: inset 0 0 0 1px rgba(255,255,255,0.03);
            transform: rotate(-10deg);
            color: #89d6ff;
            font: 800 1.55rem/1 'Orbitron', sans-serif;
            text-transform: uppercase;
        }

        .activity-grid {
            grid-template-columns: repeat(2, minmax(0, 1fr));
        }

        .activity-card {
            padding: 14px;
        }

        .activity-item {
            display: flex;
            align-items: center;
            justify-content: space-between;
            gap: 10px;
            padding: 12px 0;
            border-bottom: 1px solid rgba(255, 255, 255, 0.06);
        }

        .activity-item:last-child {
            border-bottom: 0;
            padding-bottom: 0;
        }

        .activity-item:first-child {
            padding-top: 0;
        }

        .activity-item__title {
            font-weight: 700;
        }

        .activity-item__meta {
            margin-top: 4px;
            color: rgba(255, 255, 255, 0.6);
            font: 600 0.78rem/1.35 'Rajdhani', sans-serif;
        }

        .activity-item__pill {
            flex: 0 0 auto;
            padding: 7px 10px;
            border-radius: 999px;
            background: rgba(74, 72, 235, 0.16);
            border: 1px solid rgba(74, 72, 235, 0.26);
            color: #a6b6ff;
            font: 700 0.78rem/1 'Rajdhani', sans-serif;
        }

        .flash-grid {
            grid-template-columns: 1fr;
        }

        .flash-card {
            padding: 14px 16px;
            color: white;
        }

        .flash-card--success {
            border-color: rgba(86, 226, 175, 0.2);
            background: linear-gradient(180deg, rgba(14, 46, 39, 0.68), rgba(8, 23, 21, 0.82));
        }

        .flash-card--error {
            border-color: rgba(255, 110, 158, 0.22);
            background: linear-gradient(180deg, rgba(61, 17, 33, 0.7), rgba(28, 10, 18, 0.84));
        }

        .empty-state {
            padding: 18px;
            border-radius: 16px;
            border: 1px dashed rgba(255, 255, 255, 0.12);
            color: rgba(255, 255, 255, 0.6);
            text-align: center;
            font: 600 0.84rem/1.4 'Rajdhani', sans-serif;
        }

        @media (max-width: 767px) {
            .passport-page {
                padding-top: 84px;
            }

            .hero-main {
                grid-template-columns: 1fr;
                text-align: center;
            }

            .hero-avatar-wrap {
                margin: 0 auto;
            }

            .hero-name-row,
            .hero-handle,
            .hero-tier,
            .hero-actions {
                justify-content: center;
            }

            .stats-grid,
            .fandom-grid,
            .collection-grid,
            .badge-grid,
            .activity-grid,
            .share-card {
                grid-template-columns: 1fr;
            }

            .share-card {
                justify-items: start;
            }

            .share-mini {
                width: 100%;
                min-height: 82px;
                transform: none;
            }
        }
    </style>
{% endblock %}

{% block body %}
{% set successFlashes = app.flashes('success') %}
{% set errorFlashes = app.flashes('error') %}
<main
    class="passport-page"
    data-controller="passport-sync"
    data-passport-sync-providers-value="{{ connectedSyncProviders|json_encode|e('html_attr') }}"
    data-passport-sync-sync-label-value="{{ 'passport.sync'|trans }}"
    data-passport-sync-syncing-label-value="{{ 'passport.syncing'|trans }}"
    data-passport-sync-no-providers-message-value="{{ 'passport.sync_status.no_providers'|trans }}"
    data-passport-sync-syncing-message-value="{{ 'passport.sync_status.syncing'|trans }}"
    data-passport-sync-success-message-value="{{ 'passport.sync_status.success'|trans }}"
    data-passport-sync-timeout-message-value="{{ 'passport.sync_status.timeout'|trans }}"
    data-passport-sync-failed-message-value="{{ 'passport.sync_status.failed'|trans }}"
    data-passport-sync-response-status-prefix-value="{{ 'common.response_status'|trans }}"
    data-passport-sync-logout-failed-message-value="{{ 'passport.sync_status.logout_failed'|trans }}"
    data-passport-sync-no-provider-label-value="{{ 'passport.sync_status.no_provider_label'|trans }}"
    data-passport-sync-details-prefix-value="{{ 'passport.sync_status.details_prefix'|trans }}"
    data-passport-sync-provider-fallback-label-value="{{ 'passport.sync_status.provider'|trans }}"
    data-passport-sync-unknown-status-label-value="{{ 'passport.sync_status.unknown'|trans }}"
    data-passport-sync-new-label-value="{{ 'passport.sync_status.new'|trans }}"
>
    <div class="passport-stack">
        <section class="passport-panel">
            <div class="passport-panel__inner">
                <div class="hero-grid">
                    <div class="hero-main">
                        <div class="hero-avatar-wrap">
                            <div class="hero-avatar-ring">
                                {% include 'components/user_avatar.html.twig' with {
                                    avatarUrl: user.avatarUrl,
                                    displayName: profile.username|default(user.displayName),
                                    avatarClass: 'hero-avatar'
                                } only %}
                            </div>
                            <a href="{{ path('app_front_passport_settings') }}" class="hero-avatar-edit" aria-label="{{ 'passport.edit'|trans }}">
                                <i class="fas fa-pen"></i>
                            </a>
                        </div>

                        <div class="hero-copy">
                            <div class="hero-name-row">
                                <h1 class="hero-name">{{ profile.username|default(user.displayName) }}</h1>
                                <i class="fas fa-badge-check hero-verified"></i>
                            </div>
                            <div class="hero-handle">
                                <i class="fas fa-heart"></i>
                                {{ topFandoms|length and topFandoms[0].artist ? topFandoms[0].artist.name : ('passport.byas_fan'|trans) }}
                            </div>
                            <div class="hero-caption">{{ 'passport.base_level'|trans }}</div>
                            <div class="hero-level">{{ 'passport.level'|trans }} <span>{{ user.globalLevel }}</span></div>
                            <div class="hero-tier">
                                <i class="fas fa-sparkles"></i>
                                {{ globalLevelBadge.fullTitle }}
                            </div>

                            <div class="hero-progress">
                                <div class="hero-progress__bar">
                                    <div class="hero-progress__fill" style="width: {{ globalProgress.percent }}%;"></div>
                                </div>
                                <div class="hero-progress__meta">
                                    <span>{{ user.globalXp }} XP</span>
                                    <span>{{ globalProgress.next }} XP target</span>
                                </div>
                            </div>

                            <div class="hero-actions">
                                <button id="syncHistoryBtn" class="hero-btn hero-btn--primary" type="button" data-passport-sync-target="syncButton" data-action="passport-sync#sync" {{ connectedSyncProviders is empty ? 'disabled' : '' }}>
                                    <i class="fas fa-rotate"></i>
                                    {{ 'passport.sync'|trans }}
                                </button>
                                <a href="{{ path('app_front_passport_share') }}" class="hero-btn">
                                    <i class="fas fa-share-nodes"></i>
                                    {{ 'passport.share'|trans }}
                                </a>
                                <a href="{{ path('app_front_collection_index') }}" class="hero-btn">
                                    <i class="fas fa-layer-group"></i>
                                    {{ 'passport.collection'|trans }}
                                </a>
                            </div>
                        </div>
                    </div>

                    <div id="syncFeedback" class="flash-grid" role="status" aria-live="polite" data-passport-sync-target="feedback" hidden>
                        <div class="flash-card">
                            <span data-passport-sync-target="feedbackText"></span>
                        </div>
                    </div>
                </div>
            </div>
        </section>

        <section class="passport-panel">
            <div class="passport-panel__inner">
                <div class="stats-grid">
                    <article class="stat-card">
                        <div class="stat-card__label">
                            <i class="fas fa-globe"></i>
                            {{ 'passport.global_rank'|trans }}
                        </div>
                        <div class="stat-card__value">{{ globalRank ? '#' ~ globalRank : '--' }}</div>
                        <div class="stat-card__meta">{{ 'passport.active_fandoms'|trans({ '%count%': fandoms|length }) }}</div>
                    </article>

                    <article class="stat-card stat-card--accent">
                        <div class="stat-card__label">
                            <i class="fas fa-eye"></i>
                            {{ 'passport.public_views'|trans }}
                        </div>
                        <div class="stat-card__value">{{ publicVisitCount }}</div>
                        <div class="stat-card__meta">{{ 'passport.views_7d'|trans({ '%count%': publicVisitCount7d }) }}</div>
                    </article>

                    <article class="stat-card">
                        <div class="stat-card__label">
                            <i class="fas fa-heart"></i>
                            {{ 'passport.message_intents'|trans }}
                        </div>
                        <div class="stat-card__value">{{ contactIntentCount }}</div>
                        <div class="stat-card__meta">{{ 'passport.badges_unlocked'|trans({ '%count%': userBadges|length }) }}</div>
                    </article>
                </div>
            </div>
        </section>

        <section class="passport-panel">
            <div class="passport-panel__inner">
                <div class="section-head">
                    <div class="section-title">
                        <i class="fas fa-users"></i>
                        {{ 'passport.top_fandoms'|trans }}
                    </div>
                    <a href="{{ path('app_public_passport', { shareSlug: profile.shareSlug }) }}" class="section-link">{{ 'common.view_all'|trans }}</a>
                </div>

                {% if topFandoms is not empty %}
                    <div class="fandom-grid">
                        {% for fandom in topFandoms %}
                            {% set fandomBadge = attribute(fandomLevelBadges, fandom.id) %}
                            <article class="fandom-card">
                                <div class="fandom-head">
                                    <div class="fandom-rank{% if loop.index == 2 %} fandom-rank--secondary{% elseif loop.index == 3 %} fandom-rank--tertiary{% endif %}">
                                        {{ loop.index }}
                                    </div>
                                    <i class="fas fa-heart" style="color: #9f80ff;"></i>
                                </div>
                                <div class="fandom-artist">{{ fandom.artist ? fandom.artist.name : ('passport.artist_fallback'|trans) }}</div>
                                <div class="fandom-title">{{ fandomBadge.fullTitle }}</div>
                                <div class="fandom-meta">
                                    <span>{{ 'passport.level'|trans }} {{ fandom.level }}</span>
                                    <span>{{ fandom.rankPosition ? '#' ~ fandom.rankPosition : user.globalXp ~ ' XP' }}</span>
                                </div>
                                <div class="fandom-line"></div>
                            </article>
                        {% endfor %}
                    </div>
                {% else %}
                    <div class="empty-state">{{ 'passport.empty_fandoms'|trans }}</div>
                {% endif %}
            </div>
        </section>

        <section class="passport-panel">
            <div class="passport-panel__inner">
                <div class="section-head">
                    <div class="section-title">
                        <i class="fas fa-layer-group"></i>
                        {{ 'passport.collection_mine'|trans }}
                    </div>
                    <a href="{{ path('app_front_collection_index') }}" class="section-link">{{ 'common.view_all'|trans }}</a>
                </div>

                {% if collectionHighlights is not empty %}
                    <div class="collection-grid">
                        {% for highlight in collectionHighlights %}
                            <article class="collection-card">
                                <div class="collection-icon">
                                    <i class="fas {{ highlight.icon }}"></i>
                                </div>
                                <div>
                                    <div class="collection-value">{{ highlight.count }}</div>
                                    <div class="collection-label">{{ highlight.label }}</div>
                                </div>
                            </article>
                        {% endfor %}
                    </div>
                {% else %}
                    <div class="empty-state">{{ 'passport.empty_collection'|trans }}</div>
                {% endif %}
            </div>
        </section>

        <section class="passport-panel">
            <div class="passport-panel__inner">
                <div class="section-head">
                    <div class="section-title">
                        <i class="fas fa-shield-star"></i>
                        {{ 'passport.rarest_badges'|trans }}
                    </div>
                    <span class="section-link">{{ 'passport.total_count'|trans({ '%count%': userBadges|length }) }}</span>
                </div>

                {% if featuredBadges is not empty %}
                    <div class="badge-grid">
                        {% for userBadge in featuredBadges %}
                            <article class="badge-card">
                                <div class="badge-crest">
                                    <i class="fas {% if loop.index == 1 %}fa-crown{% elseif loop.index == 2 %}fa-gem{% else %}fa-star{% endif %}"></i>
                                </div>
                                <div class="badge-name">{{ userBadge.badge.name }}</div>
                                <div class="badge-meta">
                                    {{ userBadge.badge.description|default('passport.badge_default_description'|trans) }}
                                </div>
                            </article>
                        {% endfor %}
                    </div>
                {% else %}
                    <div class="empty-state">{{ 'passport.empty_badges'|trans }}</div>
                {% endif %}
            </div>
        </section>

        <section class="passport-panel">
            <div class="passport-panel__inner">
                <div class="share-card">
                    <div class="share-qr">
                        <i class="fas fa-qrcode"></i>
                    </div>
                    <div>
                        <div class="share-title">{{ 'passport.share_title'|trans }}</div>
                        <div class="share-text">{{ 'passport.share_text'|trans }}</div>
                        <div class="share-link-row">
                            <a href="{{ path('app_front_passport_share') }}" class="hero-btn hero-btn--primary">
                                <i class="fas fa-image"></i>
                                {{ 'passport.share_card'|trans }}
                            </a>
                            <a href="{{ publicPassportUrl }}" class="hero-btn">
                                <i class="fas fa-arrow-up-right-from-square"></i>
                                {{ 'passport.public_page'|trans }}
                            </a>
                        </div>
                    </div>
                    <div class="share-mini">BYAS</div>
                </div>
            </div>
        </section>

        {% if successFlashes is not empty %}
            <div class="flash-grid">
                {% for message in successFlashes %}
                    <div class="flash-card flash-card--success">{{ message }}</div>
                {% endfor %}
            </div>
        {% endif %}

        {% if errorFlashes is not empty %}
            <div class="flash-grid">
                {% for message in errorFlashes %}
                    <div class="flash-card flash-card--error">{{ message }}</div>
                {% endfor %}
            </div>
        {% endif %}
    </div>
</main>
{% endblock %}
