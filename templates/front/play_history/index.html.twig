{% extends 'base.html.twig' %}

{% block title %}{{ 'play_history.title'|trans }}{% endblock %}

{% block stylesheets %}
{{ parent() }}
<link href="https://fonts.googleapis.com/css2?family=Outfit:wght@300;400;500;600;700&display=swap" rel="stylesheet">
<link rel="stylesheet" href="{{ asset('styles/front/play-history.css') }}">
{% endblock %}

{% block body %}
<div class="container native-screen is-hydrating" data-controller="screen-shell play-history">
    <div class="screen-skeleton play-history-screen-skeleton" aria-hidden="true">
        <div class="screen-skeleton__panel"></div>
        <div class="screen-skeleton__grid screen-skeleton__grid--three">
            <div class="screen-skeleton__card"></div>
            <div class="screen-skeleton__card"></div>
            <div class="screen-skeleton__card"></div>
        </div>
        <div class="screen-skeleton__stack">
            <div class="screen-skeleton__row"></div>
            <div class="screen-skeleton__row"></div>
            <div class="screen-skeleton__row"></div>
        </div>
    </div>
    <div class="screen-content">
    <!-- Header -->
    <div class="page-header">
        <div>
            <h1 class="page-title">
                <i class="fas fa-music"></i>
                {{ 'play_history.title'|trans }}
            </h1>
            <p class="page-subtitle">{{ 'play_history.subtitle'|trans }}</p>
        </div>
        <button type="button" class="page-mobile-action" data-action="play-history#openFilters">
            <i class="fas fa-sliders"></i>
            {{ 'common.filters'|trans }}
        </button>
    </div>

    {% if playHistory is not empty %}
        <!-- Stats Bar -->
        <div class="stats-bar">
            <div class="stat-card">
                <div class="stat-label">{{ 'play_history.total_tracks'|trans }}</div>
                <div class="stat-value">{{ playHistory|length }}</div>
            </div>
            <div class="stat-card">
                <div class="stat-label">{{ 'play_history.total_listening_time'|trans }}</div>
                <div class="stat-value">
                    {% set totalMs = 0 %}
                    {% for play in playHistory %}
                        {% set totalMs = totalMs + (play.durationMs ?? 0) %}
                    {% endfor %}
                    {{ (totalMs / 60000)|round }} min
                </div>
            </div>
            <div class="stat-card">
                <div class="stat-label">{{ 'play_history.most_recent'|trans }}</div>
                <div class="stat-value stat-value--compact">
                    {{ playHistory|first.playedAt|date('H:i') }}
                </div>
            </div>
        </div>

        <!-- Filters Section -->
        <div class="sheet-backdrop" data-play-history-target="backdrop" data-action="click->play-history#closeFilters" hidden></div>
        <div class="filters-section native-sheet" data-play-history-target="sheet" hidden>
            <div class="native-sheet__handle"></div>
            <div class="native-sheet__head">
                <div class="native-sheet__title">{{ 'common.filters'|trans }}</div>
                <button type="button" class="native-sheet__close" data-action="play-history#closeFilters" aria-label="{{ 'common.close'|trans }}">
                    <i class="fas fa-xmark"></i>
                </button>
            </div>
            <div class="filters-grid">
                <div class="filter-group">
                    <label class="filter-label">{{ 'play_history.search_track'|trans }}</label>
                    <input type="text" class="filter-input" id="searchInput" placeholder="{{ 'play_history.search_placeholder'|trans }}" data-play-history-target="search" data-action="input->play-history#filter">
                </div>
                <div class="filter-group">
                    <label class="filter-label">{{ 'play_history.provider'|trans }}</label>
                    <select class="filter-input" id="providerFilter" data-play-history-target="provider" data-action="change->play-history#filter">
                        <option value="">{{ 'play_history.all_providers'|trans }}</option>
                        <option value="spotify">Spotify</option>
                        <option value="apple">Apple Music</option>
                        <option value="youtube">YouTube Music</option>
                    </select>
                </div>
                <div class="filter-group">
                    <label class="filter-label">{{ 'play_history.type'|trans }}</label>
                    <select class="filter-input" id="typeFilter" data-play-history-target="type" data-action="change->play-history#filter">
                        <option value="">{{ 'play_history.all_types'|trans }}</option>
                        <option value="track">{{ 'play_history.track'|trans }}</option>
                        <option value="episode">{{ 'play_history.episode'|trans }}</option>
                    </select>
                </div>
            </div>
            <div class="native-sheet__actions">
                <button type="button" class="btn-secondary native-sheet__button" data-action="play-history#closeFilters">{{ 'common.close'|trans }}</button>
            </div>
        </div>

        <!-- Play History List -->
        <div class="play-history-list">
            {% for play in playHistory %}
                <div class="play-item"
                     data-play-history-target="item"
                     data-provider="{{ play.provider }}" 
                     data-type="{{ play.providerType }}"
                     data-title="{{ play.itemName|lower }}"
                     data-artist="{{ (play.artistName ?? '')|lower }}"
                     data-album="{{ (play.albumName ?? '')|lower }}">
                    
                    <div class="play-item-content">
                        <!-- Icon -->
                        <div class="play-icon">
                            <i class="fas fa-{% if play.providerType == 'track' %}music{% else %}podcast{% endif %}"></i>
                        </div>

                        <!-- Info -->
                        <div class="play-info">
                            <div class="play-title">{{ play.itemName }}</div>
                            
                            <div class="play-meta">
                                {% if play.artistName %}
                                    <span class="play-meta-item">
                                        <i class="fas fa-user"></i>
                                        {{ play.artistName }}
                                    </span>
                                {% endif %}
                                
                                {% if play.albumName %}
                                    <span class="play-meta-item">
                                        <i class="fas fa-compact-disc"></i>
                                        {{ play.albumName }}
                                    </span>
                                {% endif %}

                                {% if play.durationMs %}
                                    <span class="play-meta-item">
                                        <i class="fas fa-clock"></i>
                                        {{ (play.durationMs / 1000 / 60)|round }}:{{ ((play.durationMs / 1000) % 60)|round|number_format(0, '.', '') }}
                                    </span>
                                {% endif %}
                            </div>

                            <div class="play-meta">
                                <span class="provider-badge">
                                    <i class="fab fa-{{ play.provider }}"></i>
                                    {{ play.provider }}
                                </span>
                                
                                <span class="time-badge">
                                    <i class="far fa-calendar"></i>
                                    {{ play.playedAt|date('d/m/Y H:i') }}
                                </span>
                            </div>
                        </div>

                        <!-- Actions -->
                        <div class="play-actions">
                            {% if play.provider == 'spotify' and play.providerItemId %}
                                <a href="https://open.spotify.com/track/{{ play.providerItemId }}" 
                                   target="_blank" 
                                   class="action-btn spotify"
                                   title="{{ 'play_history.open_spotify'|trans }}">
                                    <i class="fab fa-spotify"></i>
                                </a>
                            {% elseif play.provider == 'youtube' and play.providerItemId %}
                                <a href="https://www.youtube.com/watch?v={{ play.providerItemId }}"
                                   target="_blank"
                                   class="action-btn"
                                   title="{{ 'play_history.open_youtube'|trans }}">
                                    <i class="fab fa-youtube"></i>
                                </a>
                            {% endif %}
                            
                        </div>
                    </div>
                </div>
            {% endfor %}
        </div>

    {% else %}
        <!-- Empty State -->
        <div class="empty-state">
            <div class="empty-icon">
                <i class="fas fa-music"></i>
            </div>
            <h2 class="empty-title">{{ 'play_history.empty_title'|trans }}</h2>
            <p class="empty-text">{{ 'play_history.empty_text'|trans }}</p>
        </div>
    {% endif %}
    </div>
</div>

{% endblock %}
